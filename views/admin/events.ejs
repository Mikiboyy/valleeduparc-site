<section class="form-section">

    <!-- =========================
         AJOUTER UN ÉVÉNEMENT
    ========================== -->

    <form
        action="/admin-vdp/events"
        method="POST"
        enctype="multipart/form-data"
        class="course-form"
    >

        <h2>Ajouter un événement</h2>


        <!-- TITRE -->

        <label for="title">
            Titre
        </label>

        <input
            type="text"
            id="title"
            name="title"
            required
        >


        <!-- DESCRIPTION -->

        <label for="description">
            Description
        </label>

        <textarea
            id="description"
            name="description"
            required
        ></textarea>


        <!-- DATES -->

        <label>
            Dates de l'événement
        </label>

        <p
            style="
                font-size: 14px;
                margin-top: 0;
                margin-bottom: 15px;
            "
        >
            Ajoute une ou plusieurs dates.
        </p>


        <!-- CONTENEUR DES DATES -->

        <div id="datesContainer">

            <div class="event-date-row">

                <input
                    type="date"
                    name="dates"
                    required
                >

            </div>

        </div>


        <!-- BOUTON AJOUTER DATE -->

        <button
            type="button"
            id="addDateButton"
            class="btn-secondary"
            style="margin-top: 15px;"
        >
            + Ajouter une date
        </button>


        <!-- LIEU -->

        <label
            for="location"
            style="margin-top: 25px;"
        >
            Lieu
        </label>

        <input
            type="text"
            id="location"
            name="location"
        >


        <!-- IMAGE -->

        <label for="image">
            Image
        </label>

        <input
            type="file"
            id="image"
            name="image"
            accept="image/*"
        >


        <!-- BOUTON -->

        <button
            type="submit"
            class="btn-primary"
            style="margin-top: 25px;"
        >
            Ajouter l'événement
        </button>

    </form>



    <!-- =========================
         ÉVÉNEMENTS EXISTANTS
    ========================== -->

    <div
        class="course-form"
        style="margin-top: 30px;"
    >

        <h2>
            Événements existants
        </h2>


        <% if (events && events.length > 0) { %>

            <% events.forEach(event => { %>

                <div class="admin-row">

                    <div>

                        <strong>
                            <%= event.title %>
                        </strong>


                        <!-- AFFICHAGE DES DATES -->

                        <% if (event.dates && event.dates.length > 0) { %>

                            <div
                                style="
                                    margin-top: 8px;
                                    font-size: 14px;
                                "
                            >

                                <% event.dates.forEach((date, index) => { %>

                                    <span>

                                        <%= new Date(date).toLocaleDateString(
                                            'fr-CA',
                                            {
                                                year: 'numeric',
                                                month: 'long',
                                                day: 'numeric'
                                            }
                                        ) %>

                                        <% if (index < event.dates.length - 1) { %>
                                            <br>
                                        <% } %>

                                    </span>

                                <% }) %>

                            </div>

                        <% } else { %>

                            <span>
                                Aucune date
                            </span>

                        <% } %>

                    </div>


                    <!-- SUPPRESSION -->

                    <form
                        action="/admin-vdp/events/<%= event._id %>/delete"
                        method="POST"
                    >

                        <button type="submit">
                            Supprimer
                        </button>

                    </form>

                </div>

            <% }) %>

        <% } else { %>

            <p>
                Aucun événement pour le moment.
            </p>

        <% } %>

    </div>

</section>



<!-- =========================
     JAVASCRIPT AJOUT DES DATES
========================= -->

<script>

document.addEventListener('DOMContentLoaded', function () {

    const datesContainer =
        document.getElementById('datesContainer');

    const addDateButton =
        document.getElementById('addDateButton');

    if (!datesContainer || !addDateButton) {
        return;
    }


    /*
        Créer une nouvelle ligne de date
    */

    function createDateRow() {

        const dateRow =
            document.createElement('div');

        dateRow.className =
            'event-date-row';


        /*
            Champ date
        */

        const dateInput =
            document.createElement('input');

        dateInput.type = 'date';

        dateInput.name = 'dates';


        /*
            Les dates ajoutées ne sont pas required.
            La première date du HTML reste required.
        */

        dateInput.required = false;


        /*
            Bouton supprimer
        */

        const removeButton =
            document.createElement('button');

        removeButton.type = 'button';

        removeButton.className =
            'remove-date-button';

        removeButton.innerHTML = '&times;';

        removeButton.setAttribute(
            'aria-label',
            'Supprimer cette date'
        );


        /*
            Supprimer la ligne
        */

        removeButton.addEventListener(
            'click',
            function () {

                dateRow.remove();

            }
        );


        /*
            Ajouter les éléments
        */

        dateRow.appendChild(dateInput);

        dateRow.appendChild(removeButton);

        datesContainer.appendChild(dateRow);


        /*
            Mettre le focus sur la nouvelle date
        */

        dateInput.focus();

    }


    /*
        Bouton + Ajouter une date
    */

    addDateButton.addEventListener(
        'click',
        function () {

            createDateRow();

        }
    );

});

</script>