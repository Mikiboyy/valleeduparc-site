<section class="form-section">

    <!-- =========================
         AJOUTER UN ÉVÉNEMENT
    ========================== -->

    <form
        action="/admin-vdp/events"
        method="POST"
        enctype="multipart/form-data"
        class="course-form"
    >

        <h2>Ajouter un événement</h2>


        <!-- TITRE -->

        <label for="title">
            Titre
        </label>

        <input
            type="text"
            id="title"
            name="title"
            required
        >


        <!-- DESCRIPTION -->

        <label for="description">
            Description
        </label>

        <textarea
            id="description"
            name="description"
            required
        ></textarea>


        <!-- =========================
             TYPE DE DATE
        ========================== -->

        <label>
            Format des dates
        </label>

        <p
            style="
                font-size: 14px;
                margin-top: 0;
                margin-bottom: 15px;
            "
        >
            Choisissez comment les dates de l'événement doivent être ajoutées.
        </p>


        <select
            id="dateType"
            name="dateType"
            style="margin-bottom: 20px;"
        >

            <option value="single">
                Une seule date
            </option>

            <option value="multiple">
                Plusieurs dates séparées
            </option>

            <option value="range">
                Plusieurs jours consécutifs
            </option>

        </select>


        <!-- =========================
             DATE SIMPLE
        ========================== -->

        <div
            id="singleDateSection"
            class="date-section"
        >

            <label for="singleDate">
                Date de l'événement
            </label>

            <input
                type="date"
                id="singleDate"
                name="singleDate"
            >

        </div>


        <!-- =========================
             PLUSIEURS DATES
        ========================== -->

        <div
            id="multipleDatesSection"
            class="date-section"
            style="display: none;"
        >

            <label>
                Dates de l'événement
            </label>

            <p
                style="
                    font-size: 14px;
                    margin-top: 0;
                    margin-bottom: 15px;
                "
            >
                Ajoutez toutes les dates où l'événement aura lieu.
            </p>


            <div id="datesContainer">

                <div class="event-date-row">

                    <input
                        type="date"
                        name="multipleDates"
                    >

                </div>

            </div>


            <button
                type="button"
                id="addDateButton"
                class="btn-secondary"
                style="margin-top: 15px;"
            >
                + Ajouter une date
            </button>

        </div>


        <!-- =========================
             PÉRIODE CONTINUE
        ========================== -->

        <div
            id="rangeDateSection"
            class="date-section"
            style="display: none;"
        >

            <label for="startDate">
                Date de début
            </label>

            <input
                type="date"
                id="startDate"
                name="startDate"
            >


            <label
                for="endDate"
                style="margin-top: 15px;"
            >
                Date de fin
            </label>

            <input
                type="date"
                id="endDate"
                name="endDate"
            >

            <p
                style="
                    font-size: 14px;
                    margin-top: 10px;
                "
            >
                Toutes les journées entre la date de début et la date de fin seront automatiquement ajoutées.
            </p>

        </div>


        <!-- LIEU -->

        <label
            for="location"
            style="margin-top: 25px;"
        >
            Lieu
        </label>

        <input
            type="text"
            id="location"
            name="location"
        >


        <!-- IMAGE -->

        <label for="image">
            Image
        </label>

        <input
            type="file"
            id="image"
            name="image"
            accept="image/*"
        >


        <!-- BOUTON -->

        <button
            type="submit"
            class="btn-primary"
            style="margin-top: 25px;"
        >
            Ajouter l'événement
        </button>

    </form>



    <!-- =========================
         ÉVÉNEMENTS EXISTANTS
    ========================== -->

    <div
        class="course-form"
        style="margin-top: 30px;"
    >

        <h2>
            Événements existants
        </h2>


        <% if (events && events.length > 0) { %>

            <% events.forEach(event => { %>

                <div class="admin-row">

                    <div>

                        <strong>
                            <%= event.title %>
                        </strong>


                        <!-- AFFICHAGE DES DATES -->

                        <% if (event.dates && event.dates.length > 0) { %>

                            <div
                                style="
                                    margin-top: 8px;
                                    font-size: 14px;
                                "
                            >

                                <% event.dates.forEach((date, index) => { %>

                                    <span>

                                        <%= new Date(date).toLocaleDateString(
                                            'fr-CA',
                                            {
                                                year: 'numeric',
                                                month: 'long',
                                                day: 'numeric'
                                            }
                                        ) %>

                                        <% if (index < event.dates.length - 1) { %>
                                            <br>
                                        <% } %>

                                    </span>

                                <% }) %>

                            </div>

                        <% } else { %>

                            <span>
                                Aucune date
                            </span>

                        <% } %>

                    </div>


                    <!-- SUPPRESSION -->

                    <form
                        action="/admin-vdp/events/<%= event._id %>/delete"
                        method="POST"
                    >

                        <button type="submit">
                            Supprimer
                        </button>

                    </form>

                </div>

            <% }) %>

        <% } else { %>

            <p>
                Aucun événement pour le moment.
            </p>

        <% } %>

    </div>

</section>



<script>

document.addEventListener('DOMContentLoaded', function () {


    /* =========================================================
       ÉLÉMENTS
    ========================================================= */

    const dateType =
        document.getElementById('dateType');

    const singleDateSection =
        document.getElementById('singleDateSection');

    const multipleDatesSection =
        document.getElementById('multipleDatesSection');

    const rangeDateSection =
        document.getElementById('rangeDateSection');

    const singleDate =
        document.getElementById('singleDate');

    const startDate =
        document.getElementById('startDate');

    const endDate =
        document.getElementById('endDate');

    const datesContainer =
        document.getElementById('datesContainer');

    const addDateButton =
        document.getElementById('addDateButton');

    const form =
        document.querySelector('.course-form');


    /* =========================================================
       SÉCURITÉ
    ========================================================= */

    if (
        !dateType ||
        !singleDateSection ||
        !multipleDatesSection ||
        !rangeDateSection ||
        !singleDate ||
        !startDate ||
        !endDate ||
        !datesContainer ||
        !form
    ) {
        return;
    }


    /* =========================================================
       FONCTION : RÉCUPÉRER LES CHAMPS DE DATES MULTIPLES
    ========================================================= */

    function getMultipleDateInputs() {

        return Array.from(
            datesContainer.querySelectorAll(
                'input[name="multipleDates"]'
            )
        );

    }


    /* =========================================================
       FONCTION : VÉRIFIER S'IL Y A DÉJÀ UN CHAMP VIDE
    ========================================================= */

    function hasEmptyDateInput() {

        const inputs =
            getMultipleDateInputs();

        return inputs.some(input => {

            return input.value === '';

        });

    }


    /* =========================================================
       FONCTION : METTRE À JOUR REQUIRED
    ========================================================= */

    function updateMultipleRequired() {

        const inputs =
            getMultipleDateInputs();

        inputs.forEach((input, index) => {

            input.required =
                dateType.value === 'multiple' &&
                index === 0;

        });

    }


    /* =========================================================
       CHANGER LE TYPE DE DATE
    ========================================================= */

    function updateDateSections() {

        const selectedType =
            dateType.value;


        /*
            Cacher toutes les sections
        */

        singleDateSection.style.display =
            'none';

        multipleDatesSection.style.display =
            'none';

        rangeDateSection.style.display =
            'none';


        /*
            Enlever required partout
        */

        singleDate.required =
            false;

        startDate.required =
            false;

        endDate.required =
            false;


        const multipleDateInputs =
            getMultipleDateInputs();

        multipleDateInputs.forEach(input => {

            input.required =
                false;

        });


        /*
            DATE SIMPLE
        */

        if (selectedType === 'single') {

            singleDateSection.style.display =
                'block';

            singleDate.required =
                true;

        }


        /*
            PLUSIEURS DATES
        */

        if (selectedType === 'multiple') {

            multipleDatesSection.style.display =
                'block';


            /*
                S'assurer qu'il existe
                toujours au moins un champ
            */

            if (
                getMultipleDateInputs().length === 0
            ) {

                createDateRow(false);

            }


            updateMultipleRequired();

        }


        /*
            PÉRIODE CONTINUE
        */

        if (selectedType === 'range') {

            rangeDateSection.style.display =
                'block';

            startDate.required =
                true;

            endDate.required =
                true;

        }

    }


    /* =========================================================
       ÉVÉNEMENT CHANGEMENT TYPE
    ========================================================= */

    dateType.addEventListener(
        'change',
        function () {

            updateDateSections();

        }
    );


    /* =========================================================
       CRÉER UNE NOUVELLE LIGNE DE DATE
    ========================================================= */

    function createDateRow(autoFocus = false) {


        /*
            Créer la ligne
        */

        const dateRow =
            document.createElement('div');

        dateRow.className =
            'event-date-row';


        /*
            Style forcé pour éviter
            que la ligne soit invisible
        */

        dateRow.style.display =
            'flex';

        dateRow.style.visibility =
            'visible';

        dateRow.style.opacity =
            '1';

        dateRow.style.position =
            'relative';

        dateRow.style.alignItems =
            'center';

        dateRow.style.gap =
            '10px';

        dateRow.style.width =
            '100%';

        dateRow.style.minHeight =
            '42px';

        dateRow.style.marginTop =
            '10px';

        dateRow.style.marginBottom =
            '10px';


        /* =====================================================
           CHAMP DATE
        ===================================================== */

        const dateInput =
            document.createElement('input');

        dateInput.type =
            'date';

        dateInput.name =
            'multipleDates';

        dateInput.required =
            false;

        dateInput.style.display =
            'block';

        dateInput.style.visibility =
            'visible';

        dateInput.style.opacity =
            '1';

        dateInput.style.flex =
            '1';

        dateInput.style.width =
            '100%';

        dateInput.style.minWidth =
            '0';


        /* =====================================================
           BOUTON SUPPRIMER
        ===================================================== */

        const removeButton =
            document.createElement('button');

        removeButton.type =
            'button';

        removeButton.className =
            'remove-date-button';

        removeButton.innerHTML =
            '&times;';

        removeButton.setAttribute(
            'aria-label',
            'Supprimer cette date'
        );

        removeButton.style.flexShrink =
            '0';


        /* =====================================================
           SUPPRIMER LA DATE
        ===================================================== */

        removeButton.addEventListener(
            'click',
            function () {

                const rows =
                    datesContainer.querySelectorAll(
                        '.event-date-row'
                    );


                /*
                    S'il reste seulement
                    une ligne, on la vide
                */

                if (rows.length <= 1) {

                    dateInput.value =
                        '';

                    return;

                }


                dateRow.remove();


                updateMultipleRequired();


                /*
                    S'assurer qu'il reste
                    un champ vide à la fin
                    si nécessaire
                */

                if (
                    dateType.value === 'multiple' &&
                    !hasEmptyDateInput()
                ) {

                    createDateRow(false);

                }

            }
        );


        /* =====================================================
           AJOUT AUTOMATIQUE DU PROCHAIN CHAMP
        ===================================================== */

        function handleDateSelected() {

            if (!dateInput.value) {

                return;

            }


            /*
                Vérifier que ce champ est
                le dernier de la liste
            */

            const rows =
                Array.from(
                    datesContainer.querySelectorAll(
                        '.event-date-row'
                    )
                );

            const lastRow =
                rows[rows.length - 1];


            /*
                On ajoute uniquement si :

                - le type est "multiple"
                - cette ligne est la dernière
                - aucun champ vide n'existe déjà
            */

            if (
                dateType.value === 'multiple' &&
                dateRow === lastRow &&
                !hasEmptyDateInput()
            ) {


                /*
                    IMPORTANT

                    Petit délai pour permettre
                    au calendrier natif du navigateur
                    de terminer sa fermeture.

                    Cela évite le bug où le champ
                    existe mais n'apparaît pas avant
                    de cliquer ailleurs.
                */

                setTimeout(function () {


                    /*
                        Revérifier après le délai
                        pour éviter les doublons
                    */

                    if (!hasEmptyDateInput()) {

                        createDateRow(false);

                    }


                    /*
                        Forcer le navigateur
                        à recalculer l'affichage
                    */

                    requestAnimationFrame(function () {

                        datesContainer.style.display =
                            'none';

                        void datesContainer.offsetHeight;

                        datesContainer.style.display =
                            '';

                    });

                }, 100);

            }

        }


        /*
            Certains navigateurs réagissent
            mieux à input, d'autres à change.
        */

        dateInput.addEventListener(
            'change',
            handleDateSelected
        );

        dateInput.addEventListener(
            'input',
            handleDateSelected
        );


        /* =====================================================
           AJOUTER LES ÉLÉMENTS
        ===================================================== */

        dateRow.appendChild(
            dateInput
        );

        dateRow.appendChild(
            removeButton
        );


        /*
            Ajouter la nouvelle ligne
            directement à la fin
        */

        datesContainer.appendChild(
            dateRow
        );


        /*
            Forcer le recalcul visuel
        */

        void dateRow.offsetHeight;


        requestAnimationFrame(function () {

            dateRow.style.display =
                'flex';

            dateRow.style.visibility =
                'visible';

            dateRow.style.opacity =
                '1';

        });


        /*
            Mettre à jour required
        */

        updateMultipleRequired();


        /*
            Focus seulement lors
            d'un ajout manuel
        */

        if (autoFocus) {

            setTimeout(function () {

                dateInput.focus();

            }, 50);

        }


        return dateInput;

    }


    /* =========================================================
       PRÉPARER LE PREMIER CHAMP EXISTANT
    ========================================================= */

    function prepareExistingDateInputs() {

        const existingInputs =
            getMultipleDateInputs();


        existingInputs.forEach(input => {

            /*
                Éviter de préparer
                deux fois le même champ
            */

            if (
                input.dataset.initialized === 'true'
            ) {
                return;
            }


            input.dataset.initialized =
                'true';


            function handleExistingDateSelected() {

                if (!input.value) {

                    return;

                }


                const inputs =
                    getMultipleDateInputs();

                const lastInput =
                    inputs[inputs.length - 1];


                if (
                    dateType.value === 'multiple' &&
                    input === lastInput &&
                    !hasEmptyDateInput()
                ) {

                    setTimeout(function () {

                        if (!hasEmptyDateInput()) {

                            createDateRow(false);

                        }


                        requestAnimationFrame(function () {

                            datesContainer.style.display =
                                'none';

                            void datesContainer.offsetHeight;

                            datesContainer.style.display =
                                '';

                        });

                    }, 100);

                }

            }


            input.addEventListener(
                'change',
                handleExistingDateSelected
            );

            input.addEventListener(
                'input',
                handleExistingDateSelected
            );

        });


        updateMultipleRequired();

    }


    prepareExistingDateInputs();


    /* =========================================================
       BOUTON AJOUTER UNE DATE
    ========================================================= */

    if (addDateButton) {

        addDateButton.addEventListener(
            'click',
            function () {


                /*
                    Ajouter seulement
                    s'il n'y a pas déjà
                    un champ vide
                */

                if (!hasEmptyDateInput()) {

                    createDateRow(true);

                }

            }
        );

    }


    /* =========================================================
       VÉRIFIER LA PÉRIODE
    ========================================================= */

    endDate.addEventListener(
        'change',
        function () {

            if (
                startDate.value &&
                endDate.value &&
                endDate.value < startDate.value
            ) {

                alert(
                    'La date de fin ne peut pas être avant la date de début.'
                );

                endDate.value =
                    '';

            }

        }
    );


    /* =========================================================
       INITIALISATION
    ========================================================= */

    updateDateSections();


    /* =========================================================
       AVANT L'ENVOI DU FORMULAIRE
    ========================================================= */

    form.addEventListener(
        'submit',
        function (event) {


            /*
                Supprimer les anciens
                champs cachés générés
            */

            document.querySelectorAll(
                '.generated-date-input'
            ).forEach(input => {

                input.remove();

            });


            const selectedType =
                dateType.value;


            /*
                Ajouter une date cachée
                pour le backend
            */

            function addHiddenDate(value) {

                if (!value) {

                    return;

                }


                const hiddenInput =
                    document.createElement('input');

                hiddenInput.type =
                    'hidden';

                hiddenInput.name =
                    'dates';

                hiddenInput.value =
                    value;

                hiddenInput.className =
                    'generated-date-input';

                form.appendChild(
                    hiddenInput
                );

            }


            /* ================================================
               DATE SIMPLE
            ================================================= */

            if (
                selectedType === 'single'
            ) {

                addHiddenDate(
                    singleDate.value
                );

            }


            /* ================================================
               PLUSIEURS DATES
            ================================================= */

            if (
                selectedType === 'multiple'
            ) {

                const inputs =
                    getMultipleDateInputs();


                inputs.forEach(input => {

                    if (input.value) {

                        addHiddenDate(
                            input.value
                        );

                    }

                });

            }


            /* ================================================
               PÉRIODE CONTINUE
            ================================================= */

            if (
                selectedType === 'range'
            ) {

                if (
                    startDate.value &&
                    endDate.value
                ) {

                    const start =
                        new Date(
                            startDate.value +
                            'T00:00:00'
                        );

                    const end =
                        new Date(
                            endDate.value +
                            'T00:00:00'
                        );


                    const current =
                        new Date(start);


                    while (
                        current <= end
                    ) {

                        const year =
                            current.getFullYear();

                        const month =
                            String(
                                current.getMonth() + 1
                            ).padStart(
                                2,
                                '0'
                            );

                        const day =
                            String(
                                current.getDate()
                            ).padStart(
                                2,
                                '0'
                            );


                        addHiddenDate(
                            `${year}-${month}-${day}`
                        );


                        current.setDate(
                            current.getDate() + 1
                        );

                    }

                }

            }

        }
    );

});

</script>