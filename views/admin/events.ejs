<section class="form-section">

    <!-- =========================
         AJOUTER UN ÉVÉNEMENT
    ========================== -->

    <form
        action="/admin-vdp/events"
        method="POST"
        enctype="multipart/form-data"
        class="course-form"
    >

        <h2>Ajouter un événement</h2>


        <!-- =========================
             TITRE
        ========================== -->

        <label>Titre</label>

        <input
            type="text"
            name="title"
            required
        >


        <!-- =========================
             DESCRIPTION
        ========================== -->

        <label>Description</label>

        <textarea
            name="description"
            required
        ></textarea>


        <!-- =========================
             TYPE DE DATE
        ========================== -->

        <label>Type de date</label>

        <select
            name="dateType"
            id="dateType"
            required
        >

            <option value="single">
                Une seule journée
            </option>

            <option value="multiple">
                Plusieurs dates
            </option>

            <option value="range">
                Plusieurs jours consécutifs
            </option>

        </select>


        <!-- =========================
             UNE SEULE DATE
        ========================== -->

        <div
            class="date-option"
            id="singleDateOption"
        >

            <label>Date de l'événement</label>

            <input
                type="date"
                name="date"
                id="singleDate"
            >

        </div>


        <!-- =========================
             PLUSIEURS DATES
        ========================== -->

        <div
            class="date-option"
            id="multipleDatesOption"
            style="display:none;"
        >

            <label>Dates de l'événement</label>

            <p style="font-size:14px;">
                Ajoute une date pour chaque journée où l'événement a lieu.
            </p>


            <div id="datesContainer">

                <!-- Première date -->

                <div class="date-row">

                    <input
                        type="date"
                        name="dates"
                        class="multiple-date"
                    >

                    <button
                        type="button"
                        class="remove-date-btn"
                    >
                        ×
                    </button>

                </div>

            </div>


            <button
                type="button"
                id="addDateButton"
                class="btn-secondary"
            >
                + Ajouter une date
            </button>

        </div>


        <!-- =========================
             PÉRIODE CONTINUE
        ========================== -->

        <div
            class="date-option"
            id="rangeDateOption"
            style="display:none;"
        >

            <label>Date de début</label>

            <input
                type="date"
                name="startDate"
                id="startDate"
            >


            <label>Date de fin</label>

            <input
                type="date"
                name="endDate"
                id="endDate"
            >

        </div>


        <!-- =========================
             LIEU
        ========================== -->

        <label>Lieu</label>

        <input
            type="text"
            name="location"
        >


        <!-- =========================
             IMAGE
        ========================== -->

        <label>Image</label>

        <input
            type="file"
            name="image"
            accept="image/*"
        >


        <!-- =========================
             BOUTON
        ========================== -->

        <button
            type="submit"
            class="btn-primary"
        >
            Ajouter l’événement
        </button>

    </form>


    <!-- =========================
         ÉVÉNEMENTS EXISTANTS
    ========================== -->

    <div
        class="course-form"
        style="margin-top:30px;"
    >

        <h2>Événements existants</h2>


        <% if (events && events.length > 0) { %>

            <% events.forEach(event => { %>

                <div class="admin-row">

                    <strong>
                        <%= event.title %>
                    </strong>


                    <!-- =========================
                         PLUSIEURS DATES
                    ========================== -->

                    <% if (
                        event.dates &&
                        event.dates.length > 1
                    ) { %>

                        <span>

                            <% event.dates.forEach((date, index) => { %>

                                <%= new Date(date).toLocaleDateString('fr-CA') %>

                                <%= index < event.dates.length - 1 ? ' • ' : '' %>

                            <% }) %>

                        </span>


                    <!-- =========================
                         PÉRIODE CONTINUE
                    ========================== -->

                    <% } else if (
                        event.startDate &&
                        event.endDate
                    ) { %>

                        <span>

                            Du
                            <%= new Date(event.startDate).toLocaleDateString('fr-CA') %>

                            au
                            <%= new Date(event.endDate).toLocaleDateString('fr-CA') %>

                        </span>


                    <!-- =========================
                         UNE SEULE DATE
                    ========================== -->

                    <% } else { %>

                        <span>

                            <%= new Date(event.date).toLocaleDateString('fr-CA') %>

                        </span>

                    <% } %>


                    <!-- =========================
                         SUPPRIMER
                    ========================== -->

                    <form
                        action="/admin-vdp/events/<%= event._id %>/delete"
                        method="POST"
                    >

                        <button type="submit">
                            Supprimer
                        </button>

                    </form>

                </div>

            <% }) %>

        <% } else { %>

            <p>
                Aucun événement pour le moment.
            </p>

        <% } %>

    </div>

</section>


<!-- =========================
     JAVASCRIPT GESTION DATES
========================= -->

<script>

document.addEventListener('DOMContentLoaded', () => {

    const dateType =
        document.getElementById('dateType');

    const singleDateOption =
        document.getElementById('singleDateOption');

    const multipleDatesOption =
        document.getElementById('multipleDatesOption');

    const rangeDateOption =
        document.getElementById('rangeDateOption');


    const singleDate =
        document.getElementById('singleDate');

    const startDate =
        document.getElementById('startDate');

    const endDate =
        document.getElementById('endDate');


    const datesContainer =
        document.getElementById('datesContainer');

    const addDateButton =
        document.getElementById('addDateButton');


    /* =========================================
       AFFICHER LE BON TYPE DE DATE
    ========================================= */

    function updateDateOptions() {

        const type = dateType.value;


        // Cacher toutes les options

        singleDateOption.style.display = 'none';

        multipleDatesOption.style.display = 'none';

        rangeDateOption.style.display = 'none';


        // Retirer tous les required

        singleDate.required = false;

        startDate.required = false;

        endDate.required = false;


        const multipleInputs =
            datesContainer.querySelectorAll('.multiple-date');


        multipleInputs.forEach(input => {

            input.required = false;

        });


        /* =========================
           UNE SEULE JOURNÉE
        ========================== */

        if (type === 'single') {

            singleDateOption.style.display = 'block';

            singleDate.required = true;

        }


        /* =========================
           PLUSIEURS DATES
        ========================== */

        else if (type === 'multiple') {

            multipleDatesOption.style.display = 'block';


            const dateInputs =
                datesContainer.querySelectorAll(
                    '.multiple-date'
                );


            if (dateInputs.length > 0) {

                dateInputs[0].required = true;

            }

        }


        /* =========================
           PÉRIODE CONTINUE
        ========================== */

        else if (type === 'range') {

            rangeDateOption.style.display = 'block';

            startDate.required = true;

            endDate.required = true;

        }

    }


    /* =========================================
       AJOUTER UNE LIGNE DE DATE
    ========================================= */

    function createDateRow() {

        const dateRow =
            document.createElement('div');


        dateRow.className =
            'date-row';


        const input =
            document.createElement('input');


        input.type =
            'date';

        input.name =
            'dates';

        input.className =
            'multiple-date';


        const removeButton =
            document.createElement('button');


        removeButton.type =
            'button';

        removeButton.className =
            'remove-date-btn';

        removeButton.textContent =
            '×';


        dateRow.appendChild(input);

        dateRow.appendChild(removeButton);


        datesContainer.appendChild(dateRow);


        /*
           Lorsqu'une date est sélectionnée,
           si c'est la dernière ligne,
           on crée automatiquement
           une nouvelle ligne vide.
        */

        input.addEventListener(
            'change',
            handleDateChange
        );


        updateRemoveButtons();


        return input;

    }


    /* =========================================
       LORSQU'UNE DATE EST SÉLECTIONNÉE
    ========================================= */

    function handleDateChange(event) {

        const inputs =
            datesContainer.querySelectorAll(
                '.multiple-date'
            );


        const lastInput =
            inputs[inputs.length - 1];


        /*
           Si la dernière date est remplie,
           ajouter automatiquement une nouvelle ligne
        */

        if (
            event.target === lastInput &&
            event.target.value !== ''
        ) {

            createDateRow();

        }


        updateRemoveButtons();

    }


    /* =========================================
       AJOUTER UNE DATE AVEC LE BOUTON
    ========================================= */

    addDateButton.addEventListener(
        'click',
        () => {

            const input =
                createDateRow();


            input.focus();

        }
    );


    /* =========================================
       SUPPRIMER UNE DATE
    ========================================= */

    datesContainer.addEventListener(
        'click',
        event => {

            if (
                event.target.classList.contains(
                    'remove-date-btn'
                )
            ) {

                const dateRows =
                    datesContainer.querySelectorAll(
                        '.date-row'
                    );


                /*
                   S'il y a plus d'une ligne,
                   supprimer la ligne.
                */

                if (dateRows.length > 1) {

                    event.target
                        .closest('.date-row')
                        .remove();

                }


                /*
                   S'il ne reste qu'une seule ligne,
                   simplement vider la date.
                */

                else {

                    const input =
                        event.target
                            .closest('.date-row')
                            .querySelector(
                                '.multiple-date'
                            );


                    input.value = '';

                }


                updateRemoveButtons();

            }

        }
    );


    /* =========================================
       AFFICHAGE DES BOUTONS SUPPRIMER
    ========================================= */

    function updateRemoveButtons() {

        const dateRows =
            datesContainer.querySelectorAll(
                '.date-row'
            );


        dateRows.forEach(
            (row, index) => {

                const button =
                    row.querySelector(
                        '.remove-date-btn'
                    );


                /*
                   On cache le bouton
                   si une seule ligne existe.
                */

                if (dateRows.length === 1) {

                    button.style.display =
                        'none';

                } else {

                    button.style.display =
                        'flex';

                }

            }
        );

    }


    /* =========================================
       INITIALISER LA PREMIÈRE DATE
    ========================================= */

    const firstDateInput =
        datesContainer.querySelector(
            '.multiple-date'
        );


    firstDateInput.addEventListener(
        'change',
        handleDateChange
    );


    /* =========================================
       CHANGER LE TYPE DE DATE
    ========================================= */

    dateType.addEventListener(
        'change',
        updateDateOptions
    );


    /* =========================================
       INITIALISATION
    ========================================= */

    updateDateOptions();

    updateRemoveButtons();

});

</script>