<section class="form-section">

    <!-- =========================
         AJOUTER UN ÉVÉNEMENT
    ========================== -->

    <form
        action="/admin-vdp/events"
        method="POST"
        enctype="multipart/form-data"
        class="course-form"
    >

        <h2>Ajouter un événement</h2>


        <!-- TITRE -->

        <label for="title">
            Titre
        </label>

        <input
            type="text"
            id="title"
            name="title"
            required
        >


        <!-- DESCRIPTION -->

        <label for="description">
            Description
        </label>

        <textarea
            id="description"
            name="description"
            required
        ></textarea>


        <!-- =========================
             TYPE DE DATE
        ========================== -->

        <label>
            Format des dates
        </label>

        <p
            style="
                font-size: 14px;
                margin-top: 0;
                margin-bottom: 15px;
            "
        >
            Choisissez comment les dates de l'événement doivent être ajoutées.
        </p>


        <select
            id="dateType"
            name="dateType"
            style="margin-bottom: 20px;"
        >

            <option value="single">
                Une seule date
            </option>

            <option value="multiple">
                Plusieurs dates séparées
            </option>

            <option value="range">
                Plusieurs jours consécutifs
            </option>

        </select>


        <!-- =========================
             DATE SIMPLE
        ========================== -->

        <div
            id="singleDateSection"
            class="date-section"
        >

            <label for="singleDate">
                Date de l'événement
            </label>

            <input
                type="date"
                id="singleDate"
                name="singleDate"
            >

        </div>


        <!-- =========================
             PLUSIEURS DATES
        ========================== -->

        <div
            id="multipleDatesSection"
            class="date-section"
            style="display: none;"
        >

            <label>
                Dates de l'événement
            </label>

            <p
                style="
                    font-size: 14px;
                    margin-top: 0;
                    margin-bottom: 15px;
                "
            >
                Ajoutez toutes les dates où l'événement aura lieu.
            </p>


            <div id="datesContainer">

                <div class="event-date-row">

                    <input
                        type="date"
                        name="multipleDates"
                    >

                </div>

            </div>


            <button
                type="button"
                id="addDateButton"
                class="btn-secondary"
                style="margin-top: 15px;"
            >
                + Ajouter une date
            </button>

        </div>


        <!-- =========================
             PÉRIODE CONTINUE
        ========================== -->

        <div
            id="rangeDateSection"
            class="date-section"
            style="display: none;"
        >

            <label for="startDate">
                Date de début
            </label>

            <input
                type="date"
                id="startDate"
                name="startDate"
            >


            <label
                for="endDate"
                style="margin-top: 15px;"
            >
                Date de fin
            </label>

            <input
                type="date"
                id="endDate"
                name="endDate"
            >

            <p
                style="
                    font-size: 14px;
                    margin-top: 10px;
                "
            >
                Toutes les journées entre la date de début et la date de fin seront automatiquement ajoutées.
            </p>

        </div>


        <!-- LIEU -->

        <label
            for="location"
            style="margin-top: 25px;"
        >
            Lieu
        </label>

        <input
            type="text"
            id="location"
            name="location"
        >


        <!-- IMAGE -->

        <label for="image">
            Image
        </label>

        <input
            type="file"
            id="image"
            name="image"
            accept="image/*"
        >


        <!-- BOUTON -->

        <button
            type="submit"
            class="btn-primary"
            style="margin-top: 25px;"
        >
            Ajouter l'événement
        </button>

    </form>



    <!-- =========================
         ÉVÉNEMENTS EXISTANTS
    ========================== -->

    <div
        class="course-form"
        style="margin-top: 30px;"
    >

        <h2>
            Événements existants
        </h2>


        <% if (events && events.length > 0) { %>

            <% events.forEach(event => { %>

                <div class="admin-row">

                    <div>

                        <strong>
                            <%= event.title %>
                        </strong>


                        <!-- AFFICHAGE DES DATES -->

                        <% if (event.dates && event.dates.length > 0) { %>

                            <div
                                style="
                                    margin-top: 8px;
                                    font-size: 14px;
                                "
                            >

                                <% event.dates.forEach((date, index) => { %>

                                    <span>

                                        <%= new Date(date).toLocaleDateString(
                                            'fr-CA',
                                            {
                                                year: 'numeric',
                                                month: 'long',
                                                day: 'numeric'
                                            }
                                        ) %>

                                        <% if (index < event.dates.length - 1) { %>
                                            <br>
                                        <% } %>

                                    </span>

                                <% }) %>

                            </div>

                        <% } else { %>

                            <span>
                                Aucune date
                            </span>

                        <% } %>

                    </div>


                    <!-- SUPPRESSION -->

                    <form
                        action="/admin-vdp/events/<%= event._id %>/delete"
                        method="POST"
                    >

                        <button type="submit">
                            Supprimer
                        </button>

                    </form>

                </div>

            <% }) %>

        <% } else { %>

            <p>
                Aucun événement pour le moment.
            </p>

        <% } %>

    </div>

</section>



<script>

document.addEventListener('DOMContentLoaded', function () {

    /* =========================================================
       ÉLÉMENTS
    ========================================================= */

    const dateType =
        document.getElementById('dateType');

    const singleDateSection =
        document.getElementById('singleDateSection');

    const multipleDatesSection =
        document.getElementById('multipleDatesSection');

    const rangeDateSection =
        document.getElementById('rangeDateSection');

    const singleDate =
        document.getElementById('singleDate');

    const startDate =
        document.getElementById('startDate');

    const endDate =
        document.getElementById('endDate');

    const datesContainer =
        document.getElementById('datesContainer');

    const addDateButton =
        document.getElementById('addDateButton');

    const form =
        document.querySelector('.course-form');


    /* =========================================================
       SÉCURITÉ
    ========================================================= */

    if (
        !dateType ||
        !singleDateSection ||
        !multipleDatesSection ||
        !rangeDateSection ||
        !singleDate ||
        !startDate ||
        !endDate ||
        !datesContainer ||
        !form
    ) {
        return;
    }


    /* =========================================================
       RÉCUPÉRER LES CHAMPS DE DATES MULTIPLES
    ========================================================= */

    function getMultipleDateInputs() {

        return Array.from(
            datesContainer.querySelectorAll(
                'input[name="multipleDates"]'
            )
        );

    }


    /* =========================================================
       VÉRIFIER S'IL Y A UNE DATE VIDE
    ========================================================= */

    function hasEmptyDateInput() {

        const inputs =
            getMultipleDateInputs();

        return inputs.some(input => {

            return input.value === '';

        });

    }


    /* =========================================================
       METTRE À JOUR LES SECTIONS
    ========================================================= */

    function updateDateSections() {

        const selectedType =
            dateType.value;


        /*
           Cacher toutes les sections
        */

        singleDateSection.style.display =
            'none';

        multipleDatesSection.style.display =
            'none';

        rangeDateSection.style.display =
            'none';


        /*
           Retirer required partout
        */

        singleDate.required =
            false;

        startDate.required =
            false;

        endDate.required =
            false;


        /*
           DATE SIMPLE
        */

        if (selectedType === 'single') {

            singleDateSection.style.display =
                'block';

            singleDate.required =
                true;

        }


        /*
           PLUSIEURS DATES
        */

        if (selectedType === 'multiple') {

            multipleDatesSection.style.display =
                'block';

        }


        /*
           PÉRIODE CONTINUE
        */

        if (selectedType === 'range') {

            rangeDateSection.style.display =
                'block';

            startDate.required =
                true;

            endDate.required =
                true;

        }

    }


    /* =========================================================
       CHANGEMENT DU FORMAT DE DATE
    ========================================================= */

    dateType.addEventListener(
        'change',
        function () {

            updateDateSections();

        }
    );


    /* =========================================================
       AJOUTER UNE NOUVELLE DATE
    ========================================================= */

    function createDateRow() {

        /*
           Création de la ligne
        */

        const dateRow =
            document.createElement('div');

        dateRow.className =
            'event-date-row';


        /*
           Champ de date
        */

        const dateInput =
            document.createElement('input');

        dateInput.type =
            'date';

        dateInput.name =
            'multipleDates';


        /*
           Le champ n'est pas required.

           La validation est faite au moment
           de l'envoi du formulaire.
        */

        dateInput.required =
            false;


        /*
           Bouton X
        */

        const removeButton =
            document.createElement('button');

        removeButton.type =
            'button';

        removeButton.className =
            'remove-date-button';

        removeButton.innerHTML =
            '&times;';

        removeButton.setAttribute(
            'aria-label',
            'Supprimer cette date'
        );


        /*
           SUPPRIMER CETTE DATE

           On permet de supprimer
           n'importe quelle ligne.
        */

        removeButton.addEventListener(
            'click',
            function () {

                dateRow.remove();

            }
        );


        /*
           LORSQU'UNE DATE EST CHOISIE

           IMPORTANT :
           On utilise seulement "change".

           On n'utilise PAS "input",
           car cela peut se déclencher
           pendant la navigation entre
           les mois du calendrier.
        */

        dateInput.addEventListener(
            'change',
            function () {

                /*
                   Si aucune date n'est sélectionnée
                */

                if (!dateInput.value) {
                    return;
                }


                /*
                   Vérifier que cette date est
                   la dernière de la liste
                */

                const inputs =
                    getMultipleDateInputs();

                const lastInput =
                    inputs[inputs.length - 1];


                /*
                   Ajouter une nouvelle ligne
                   seulement si :

                   - format = plusieurs dates
                   - cette date est la dernière
                   - aucun champ vide n'existe
                */

                if (
                    dateType.value === 'multiple' &&
                    dateInput === lastInput &&
                    !hasEmptyDateInput()
                ) {

                    /*
                       Ajouter le prochain champ
                       APRÈS la sélection complète
                       de la date.
                    */

                    createDateRow();

                }

            }
        );


        /*
           Ajouter le champ
        */

        dateRow.appendChild(
            dateInput
        );

        dateRow.appendChild(
            removeButton
        );


        /*
           Ajouter la ligne
           directement à la fin
        */

        datesContainer.appendChild(
            dateRow
        );


        return dateInput;

    }


    /* =========================================================
       PRÉPARER LES CHAMPS EXISTANTS
    ========================================================= */

    function prepareExistingDateInputs() {

        const existingInputs =
            getMultipleDateInputs();


        existingInputs.forEach(function (input) {

            /*
               Éviter d'initialiser
               deux fois le même champ
            */

            if (
                input.dataset.initialized === 'true'
            ) {
                return;
            }


            input.dataset.initialized =
                'true';


            /*
               Trouver la ligne parente
            */

            const dateRow =
                input.closest('.event-date-row');


            /*
               Si la ligne existe
            */

            if (!dateRow) {
                return;
            }


            /*
               Ajouter un X s'il n'existe pas
            */

            let removeButton =
                dateRow.querySelector(
                    '.remove-date-button'
                );


            if (!removeButton) {

                removeButton =
                    document.createElement('button');

                removeButton.type =
                    'button';

                removeButton.className =
                    'remove-date-button';

                removeButton.innerHTML =
                    '&times;';

                removeButton.setAttribute(
                    'aria-label',
                    'Supprimer cette date'
                );

                dateRow.appendChild(
                    removeButton
                );

            }


            /*
               SUPPRESSION DE CETTE DATE
            */

            removeButton.addEventListener(
                'click',
                function () {

                    dateRow.remove();

                }
            );


            /*
               DATE SÉLECTIONNÉE

               Utilisation seulement de CHANGE
               pour éviter le bug lorsque
               l'utilisateur change de mois.
            */

            input.addEventListener(
                'change',
                function () {

                    if (!input.value) {
                        return;
                    }


                    const inputs =
                        getMultipleDateInputs();

                    const lastInput =
                        inputs[inputs.length - 1];


                    /*
                       Ajouter une nouvelle date
                       seulement si celle-ci est
                       la dernière.
                    */

                    if (
                        dateType.value === 'multiple' &&
                        input === lastInput &&
                        !hasEmptyDateInput()
                    ) {

                        createDateRow();

                    }

                }
            );

        });

    }


    /*
       Préparer les champs déjà présents
       dans le HTML
    */

    prepareExistingDateInputs();


    /* =========================================================
       BOUTON + AJOUTER UNE DATE
    ========================================================= */

    if (addDateButton) {

        addDateButton.addEventListener(
            'click',
            function () {

                /*
                   Ajouter un champ seulement
                   s'il n'y a pas déjà une
                   date vide.
                */

                if (!hasEmptyDateInput()) {

                    createDateRow();

                }

            }
        );

    }


    /* =========================================================
       VÉRIFIER LA PÉRIODE
    ========================================================= */

    endDate.addEventListener(
        'change',
        function () {

            if (
                startDate.value &&
                endDate.value &&
                endDate.value < startDate.value
            ) {

                alert(
                    'La date de fin ne peut pas être avant la date de début.'
                );

                endDate.value =
                    '';

            }

        }
    );


    /* =========================================================
       INITIALISATION
    ========================================================= */

    updateDateSections();


    /* =========================================================
       AVANT L'ENVOI DU FORMULAIRE
    ========================================================= */

    form.addEventListener(
        'submit',
        function (event) {

            /*
               Supprimer les anciens champs
               cachés générés précédemment
            */

            document.querySelectorAll(
                '.generated-date-input'
            ).forEach(function (input) {

                input.remove();

            });


            const selectedType =
                dateType.value;


            /*
               Fonction pour créer
               une date cachée envoyée
               au backend.
            */

            function addHiddenDate(value) {

                if (!value) {
                    return;
                }


                const hiddenInput =
                    document.createElement('input');

                hiddenInput.type =
                    'hidden';

                hiddenInput.name =
                    'dates';

                hiddenInput.value =
                    value;

                hiddenInput.className =
                    'generated-date-input';

                form.appendChild(
                    hiddenInput
                );

            }


            /* =================================================
               DATE SIMPLE
            ================================================= */

            if (
                selectedType === 'single'
            ) {

                if (!singleDate.value) {

                    event.preventDefault();

                    alert(
                        'Veuillez sélectionner une date.'
                    );

                    return;

                }


                addHiddenDate(
                    singleDate.value
                );

            }


            /* =================================================
               PLUSIEURS DATES
            ================================================= */

            if (
                selectedType === 'multiple'
            ) {

                const inputs =
                    getMultipleDateInputs();


                /*
                   Garder seulement les dates
                   réellement sélectionnées.
                */

                const selectedDates =
                    inputs.filter(function (input) {

                        return input.value !== '';

                    });


                /*
                   Au moins une date obligatoire
                */

                if (
                    selectedDates.length === 0
                ) {

                    event.preventDefault();

                    alert(
                        'Veuillez sélectionner au moins une date.'
                    );

                    return;

                }


                /*
                   Ajouter toutes les dates
                   sélectionnées au formulaire.
                */

                selectedDates.forEach(
                    function (input) {

                        addHiddenDate(
                            input.value
                        );

                    }
                );

            }


            /* =================================================
               PÉRIODE CONTINUE
            ================================================= */

            if (
                selectedType === 'range'
            ) {

                if (
                    !startDate.value ||
                    !endDate.value
                ) {

                    event.preventDefault();

                    alert(
                        'Veuillez sélectionner une date de début et une date de fin.'
                    );

                    return;

                }


                const start =
                    new Date(
                        startDate.value +
                        'T00:00:00'
                    );

                const end =
                    new Date(
                        endDate.value +
                        'T00:00:00'
                    );


                /*
                   Vérification supplémentaire
                */

                if (end < start) {

                    event.preventDefault();

                    alert(
                        'La date de fin ne peut pas être avant la date de début.'
                    );

                    return;

                }


                /*
                   Ajouter toutes les journées
                   entre le début et la fin.
                */

                const current =
                    new Date(start);


                while (
                    current <= end
                ) {

                    const year =
                        current.getFullYear();

                    const month =
                        String(
                            current.getMonth() + 1
                        ).padStart(
                            2,
                            '0'
                        );

                    const day =
                        String(
                            current.getDate()
                        ).padStart(
                            2,
                            '0'
                        );


                    addHiddenDate(
                        `${year}-${month}-${day}`
                    );


                    current.setDate(
                        current.getDate() + 1
                    );

                }

            }

        }
    );

});

</script>