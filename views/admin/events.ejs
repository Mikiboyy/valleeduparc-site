<section class="form-section">

    <!-- =========================
         AJOUTER UN ÉVÉNEMENT
    ========================== -->

    <form
        action="/admin-vdp/events"
        method="POST"
        enctype="multipart/form-data"
        class="course-form"
    >

        <h2>Ajouter un événement</h2>


        <!-- TITRE -->

        <label for="title">
            Titre
        </label>

        <input
            type="text"
            id="title"
            name="title"
            required
        >


        <!-- DESCRIPTION -->

        <label for="description">
            Description
        </label>

        <textarea
            id="description"
            name="description"
            required
        ></textarea>


        <!-- DATES -->

        <label>
            Dates de l'événement
        </label>

        <p
            style="
                font-size: 14px;
                margin-top: 0;
                margin-bottom: 15px;
            "
        >
            Ajoute une ou plusieurs dates.
        </p>


        <!-- CONTENEUR DES DATES -->

        <div id="datesContainer">

            <div class="event-date-row">

                <input
                    type="date"
                    name="dates"
                    required
                >

            </div>

        </div>


        <!-- BOUTON AJOUTER DATE -->

        <button
            type="button"
            id="addDateButton"
            class="btn-secondary"
            style="margin-top: 15px;"
        >
            + Ajouter une date
        </button>


        <!-- LIEU -->

        <label
            for="location"
            style="margin-top: 25px;"
        >
            Lieu
        </label>

        <input
            type="text"
            id="location"
            name="location"
        >


        <!-- IMAGE -->

        <label for="image">
            Image
        </label>

        <input
            type="file"
            id="image"
            name="image"
            accept="image/*"
        >


        <!-- BOUTON -->

        <button
            type="submit"
            class="btn-primary"
            style="margin-top: 25px;"
        >
            Ajouter l'événement
        </button>

    </form>



    <!-- =========================
         ÉVÉNEMENTS EXISTANTS
    ========================== -->

    <div
        class="course-form"
        style="margin-top: 30px;"
    >

        <h2>
            Événements existants
        </h2>


        <% if (events && events.length > 0) { %>

            <% events.forEach(event => { %>

                <div class="admin-row">

                    <div>

                        <strong>
                            <%= event.title %>
                        </strong>


                        <!-- AFFICHAGE DES DATES -->

                        <% if (event.dates && event.dates.length > 0) { %>

                            <div
                                style="
                                    margin-top: 8px;
                                    font-size: 14px;
                                "
                            >

                                <% event.dates.forEach((date, index) => { %>

                                    <span>

                                        <%= new Date(date).toLocaleDateString(
                                            'fr-CA',
                                            {
                                                year: 'numeric',
                                                month: 'long',
                                                day: 'numeric'
                                            }
                                        ) %>

                                        <% if (index < event.dates.length - 1) { %>
                                            <br>
                                        <% } %>

                                    </span>

                                <% }) %>

                            </div>

                        <% } else { %>

                            <span>
                                Aucune date
                            </span>

                        <% } %>

                    </div>


                    <!-- SUPPRESSION -->

                    <form
                        action="/admin-vdp/events/<%= event._id %>/delete"
                        method="POST"
                    >

                        <button type="submit">
                            Supprimer
                        </button>

                    </form>

                </div>

            <% }) %>

        <% } else { %>

            <p>
                Aucun événement pour le moment.
            </p>

        <% } %>

    </div>

</section>



<!-- =========================
     JAVASCRIPT AJOUT DES DATES
========================= -->

<script>

document.addEventListener(
    'DOMContentLoaded',
    function () {

        const datesContainer =
            document.getElementById('datesContainer');

        const addDateButton =
            document.getElementById('addDateButton');


        /*
            AJOUTER UNE DATE
        */

        addDateButton.addEventListener(
            'click',
            function () {

                const dateRow =
                    document.createElement('div');


                dateRow.className =
                    'event-date-row';


                const dateInput =
                    document.createElement('input');


                dateInput.type =
                    'date';


                dateInput.name =
                    'dates';


                dateInput.required =
                    true;


                /*
                    BOUTON SUPPRIMER
                */

                const removeButton =
                    document.createElement('button');


                removeButton.type =
                    'button';


                removeButton.className =
                    'remove-date-button';


                removeButton.innerHTML =
                    '&times;';


                removeButton.setAttribute(
                    'aria-label',
                    'Supprimer cette date'
                );


                /*
                    SUPPRESSION
                */

                removeButton.addEventListener(
                    'click',
                    function () {

                        const allDateRows =
                            datesContainer.querySelectorAll(
                                '.event-date-row'
                            );


                        /*
                            On doit toujours garder
                            au moins une date.
                        */

                        if (allDateRows.length <= 1) {

                            const input =
                                dateRow.querySelector(
                                    'input[type="date"]'
                                );


                            input.value =
                                '';

                            return;

                        }


                        dateRow.remove();

                    }
                );


                /*
                    AJOUT DES ÉLÉMENTS
                */

                dateRow.appendChild(
                    dateInput
                );


                dateRow.appendChild(
                    removeButton
                );


                datesContainer.appendChild(
                    dateRow
                );


                /*
                    Ouvre automatiquement
                    le sélecteur de date
                */

                dateInput.focus();


                if (typeof dateInput.showPicker === 'function') {

                    dateInput.showPicker();

                }

            }
        );

    }
);

</script>

<!-- =========================
     JAVASCRIPT GESTION DATES
========================= -->

<script>

document.addEventListener('DOMContentLoaded', () => {

    const dateType =
        document.getElementById('dateType');

    const singleDateOption =
        document.getElementById('singleDateOption');

    const multipleDatesOption =
        document.getElementById('multipleDatesOption');

    const rangeDateOption =
        document.getElementById('rangeDateOption');


    const singleDate =
        document.getElementById('singleDate');

    const startDate =
        document.getElementById('startDate');

    const endDate =
        document.getElementById('endDate');


    const datesContainer =
        document.getElementById('datesContainer');

    const addDateButton =
        document.getElementById('addDateButton');


    /* =========================================
       AFFICHER LE BON TYPE DE DATE
    ========================================= */

    function updateDateOptions() {

        const type = dateType.value;


        // Cacher toutes les options

        singleDateOption.style.display = 'none';

        multipleDatesOption.style.display = 'none';

        rangeDateOption.style.display = 'none';


        // Retirer tous les required

        singleDate.required = false;

        startDate.required = false;

        endDate.required = false;


        const multipleInputs =
            datesContainer.querySelectorAll('.multiple-date');


        multipleInputs.forEach(input => {

            input.required = false;

        });


        /* =========================
           UNE SEULE JOURNÉE
        ========================== */

        if (type === 'single') {

            singleDateOption.style.display = 'block';

            singleDate.required = true;

        }


        /* =========================
           PLUSIEURS DATES
        ========================== */

        else if (type === 'multiple') {

            multipleDatesOption.style.display = 'block';


            const dateInputs =
                datesContainer.querySelectorAll(
                    '.multiple-date'
                );


            if (dateInputs.length > 0) {

                dateInputs[0].required = true;

            }

        }


        /* =========================
           PÉRIODE CONTINUE
        ========================== */

        else if (type === 'range') {

            rangeDateOption.style.display = 'block';

            startDate.required = true;

            endDate.required = true;

        }

    }


    /* =========================================
       AJOUTER UNE LIGNE DE DATE
    ========================================= */

    function createDateRow() {

        const dateRow =
            document.createElement('div');


        dateRow.className =
            'date-row';


        const input =
            document.createElement('input');


        input.type =
            'date';

        input.name =
            'dates';

        input.className =
            'multiple-date';


        const removeButton =
            document.createElement('button');


        removeButton.type =
            'button';

        removeButton.className =
            'remove-date-btn';

        removeButton.textContent =
            '×';


        dateRow.appendChild(input);

        dateRow.appendChild(removeButton);


        datesContainer.appendChild(dateRow);


        /*
           Lorsqu'une date est sélectionnée,
           si c'est la dernière ligne,
           on crée automatiquement
           une nouvelle ligne vide.
        */

        input.addEventListener(
            'change',
            handleDateChange
        );


        updateRemoveButtons();


        return input;

    }


    /* =========================================
       LORSQU'UNE DATE EST SÉLECTIONNÉE
    ========================================= */

    function handleDateChange(event) {

        const inputs =
            datesContainer.querySelectorAll(
                '.multiple-date'
            );


        const lastInput =
            inputs[inputs.length - 1];


        /*
           Si la dernière date est remplie,
           ajouter automatiquement une nouvelle ligne
        */

        if (
            event.target === lastInput &&
            event.target.value !== ''
        ) {

            createDateRow();

        }


        updateRemoveButtons();

    }


    /* =========================================
       AJOUTER UNE DATE AVEC LE BOUTON
    ========================================= */

    addDateButton.addEventListener(
        'click',
        () => {

            const input =
                createDateRow();


            input.focus();

        }
    );


    /* =========================================
       SUPPRIMER UNE DATE
    ========================================= */

    datesContainer.addEventListener(
        'click',
        event => {

            if (
                event.target.classList.contains(
                    'remove-date-btn'
                )
            ) {

                const dateRows =
                    datesContainer.querySelectorAll(
                        '.date-row'
                    );


                /*
                   S'il y a plus d'une ligne,
                   supprimer la ligne.
                */

                if (dateRows.length > 1) {

                    event.target
                        .closest('.date-row')
                        .remove();

                }


                /*
                   S'il ne reste qu'une seule ligne,
                   simplement vider la date.
                */

                else {

                    const input =
                        event.target
                            .closest('.date-row')
                            .querySelector(
                                '.multiple-date'
                            );


                    input.value = '';

                }


                updateRemoveButtons();

            }

        }
    );


    /* =========================================
       AFFICHAGE DES BOUTONS SUPPRIMER
    ========================================= */

    function updateRemoveButtons() {

        const dateRows =
            datesContainer.querySelectorAll(
                '.date-row'
            );


        dateRows.forEach(
            (row, index) => {

                const button =
                    row.querySelector(
                        '.remove-date-btn'
                    );


                /*
                   On cache le bouton
                   si une seule ligne existe.
                */

                if (dateRows.length === 1) {

                    button.style.display =
                        'none';

                } else {

                    button.style.display =
                        'flex';

                }

            }
        );

    }


    /* =========================================
       INITIALISER LA PREMIÈRE DATE
    ========================================= */

    const firstDateInput =
        datesContainer.querySelector(
            '.multiple-date'
        );


    firstDateInput.addEventListener(
        'change',
        handleDateChange
    );


    /* =========================================
       CHANGER LE TYPE DE DATE
    ========================================= */

    dateType.addEventListener(
        'change',
        updateDateOptions
    );


    /* =========================================
       INITIALISATION
    ========================================= */

    updateDateOptions();

    updateRemoveButtons();

});

</script>