<section class="form-section">

    <!-- =========================
         AJOUTER UN ÉVÉNEMENT
    ========================== -->

    <form
        action="/admin-vdp/events"
        method="POST"
        enctype="multipart/form-data"
        class="course-form"
    >

        <h2>Ajouter un événement</h2>


        <!-- TITRE -->

        <label for="title">
            Titre
        </label>

        <input
            type="text"
            id="title"
            name="title"
            maxlength="150"
            required
        >


        <!-- DESCRIPTION -->

        <label for="description">
            Description
        </label>

        <textarea
            id="description"
            name="description"
            rows="8"
            maxlength="5000"
            required
        ></textarea>


        <!-- =========================
             TYPE DE DATE
        ========================== -->

        <label>
            Format des dates
        </label>

        <p
            style="
                font-size: 14px;
                margin-top: 0;
                margin-bottom: 15px;
            "
        >
            Choisissez comment les dates de l'événement doivent être ajoutées.
        </p>


        <select
            id="dateType"
            name="dateType"
            style="margin-bottom: 20px;"
        >

            <option value="single">
                Une seule date
            </option>

            <option value="multiple">
                Plusieurs dates séparées
            </option>

            <option value="range">
                Plusieurs jours consécutifs
            </option>

        </select>


        <!-- =========================
             DATE SIMPLE
        ========================== -->

        <div
            id="singleDateSection"
            class="date-section"
        >

            <label for="singleDate">
                Date de l'événement
            </label>

            <input
                type="date"
                id="singleDate"
                name="singleDate"
            >

        </div>


        <!-- =========================
             PLUSIEURS DATES
        ========================== -->

        <div
            id="multipleDatesSection"
            class="date-section"
            style="display: none;"
        >

            <label>
                Dates de l'événement
            </label>

            <p
                style="
                    font-size: 14px;
                    margin-top: 0;
                    margin-bottom: 15px;
                "
            >
                Ajoutez toutes les dates où l'événement aura lieu.
            </p>


            <div id="datesContainer">

                <div class="event-date-row">

                    <input
                        type="date"
                        name="multipleDates"
                    >

                </div>

            </div>


            <button
                type="button"
                id="addDateButton"
                class="btn-secondary"
                style="margin-top: 15px;"
            >
                + Ajouter une date
            </button>

        </div>


        <!-- =========================
             PÉRIODE CONTINUE
        ========================== -->

        <div
            id="rangeDateSection"
            class="date-section"
            style="display: none;"
        >

            <label for="startDate">
                Date de début
            </label>

            <input
                type="date"
                id="startDate"
                name="startDate"
            >


            <label
                for="endDate"
                style="margin-top: 15px;"
            >
                Date de fin
            </label>

            <input
                type="date"
                id="endDate"
                name="endDate"
            >

            <p
                style="
                    font-size: 14px;
                    margin-top: 10px;
                "
            >
                Toutes les journées entre la date de début et la date de fin seront automatiquement ajoutées.
            </p>

        </div>


        <!-- LIEU -->

        <label
            for="location"
            style="margin-top: 25px;"
        >
            Lieu
        </label>

        <input
            type="text"
            id="location"
            name="location"
            maxlength="200"
        >


        <!-- IMAGE -->

        <label for="image">
            Image
        </label>

        <input
            type="file"
            id="image"
            name="image"
            accept="image/jpeg,image/png,image/webp"
        >


        <!-- BOUTON -->

        <button
            type="submit"
            class="btn-primary"
            style="margin-top: 25px;"
        >
            Ajouter l'événement
        </button>

    </form>



    <!-- =========================
         ÉVÉNEMENTS EXISTANTS
    ========================== -->

    <div
        class="course-form"
        style="margin-top: 30px;"
    >

        <h2>
            Événements existants
        </h2>


        <% if (events && events.length > 0) { %>

            <% events.forEach(event => { %>

                <!-- =========================
                     MODIFICATION
                ========================== -->

                <div
                    class="event-edit-container"
                    style="
                        border: 1px solid #ddd;
                        padding: 25px;
                        margin-bottom: 30px;
                        border-radius: 10px;
                    "
                >

                    <h3>
                        Modifier : <%= event.title %>
                    </h3>


                    <form
                        action="/admin-vdp/events/<%= event._id %>"
                        method="POST"
                        enctype="multipart/form-data"
                        class="event-edit-form"
                    >


                        <!-- TITRE -->

                        <label for="title-<%= event._id %>">
                            Titre de l'événement
                        </label>

                        <input
                            type="text"
                            id="title-<%= event._id %>"
                            name="title"
                            value="<%= event.title %>"
                            maxlength="150"
                            required
                        >


                        <!-- DESCRIPTION -->

                        <label for="description-<%= event._id %>">
                            Description
                        </label>

                        <textarea
                            id="description-<%= event._id %>"
                            name="description"
                            rows="8"
                            maxlength="5000"
                            required
                        ><%= event.description %></textarea>


                        <!-- =========================
                             DATES
                        ========================== -->

                        <label>
                            Dates de l'événement
                        </label>

                        <div
                            id="edit-dates-<%= event._id %>"
                            class="edit-dates-container"
                        >

                            <% if (event.dates && event.dates.length > 0) { %>

                                <% event.dates.forEach(date => { %>

                                    <div class="event-date-row">

                                        <input
                                            type="date"
                                            name="dates"
                                            value="<%= new Date(date).toISOString().split('T')[0] %>"
                                            required
                                        >

                                        <button
                                            type="button"
                                            class="remove-date-button"
                                            aria-label="Supprimer cette date"
                                        >
                                            &times;
                                        </button>

                                    </div>

                                <% }) %>

                            <% } else { %>

                                <div class="event-date-row">

                                    <input
                                        type="date"
                                        name="dates"
                                        required
                                    >

                                    <button
                                        type="button"
                                        class="remove-date-button"
                                        aria-label="Supprimer cette date"
                                    >
                                        &times;
                                    </button>

                                </div>

                            <% } %>

                        </div>


                        <!-- AJOUTER UNE DATE -->

                        <button
                            type="button"
                            class="btn-secondary add-edit-date-button"
                            data-event-id="<%= event._id %>"
                            style="margin-top: 10px;"
                        >
                            + Ajouter une date
                        </button>


                        <!-- LIEU -->

                        <label
                            for="location-<%= event._id %>"
                            style="margin-top: 20px;"
                        >
                            Lieu
                        </label>

                        <input
                            type="text"
                            id="location-<%= event._id %>"
                            name="location"
                            value="<%= event.location || '' %>"
                            maxlength="200"
                        >


                        <!-- =========================
                             IMAGE ACTUELLE
                        ========================== -->

                        <% if (event.image) { %>

                            <div
                                class="current-event-image"
                                style="margin-top: 20px;"
                            >

                                <p>
                                    <strong>Image actuelle :</strong>
                                </p>

                                <img
                                    src="<%= event.image %>"
                                    alt="<%= event.title %>"
                                    style="
                                        display: block;
                                        max-width: 300px;
                                        width: 100%;
                                        height: auto;
                                        border-radius: 8px;
                                        margin-top: 10px;
                                    "
                                >

                            </div>

                        <% } else { %>

                            <p style="margin-top: 20px;">
                                Aucune image actuellement.
                            </p>

                        <% } %>


                        <!-- =========================
                             NOUVELLE IMAGE
                        ========================== -->

                        <label
                            for="image-<%= event._id %>"
                            style="margin-top: 20px;"
                        >
                            Remplacer l'image
                        </label>

                        <input
                            type="file"
                            id="image-<%= event._id %>"
                            name="image"
                            accept="image/jpeg,image/png,image/webp"
                        >

                        <small>
                            Laissez vide pour conserver l'image actuelle.
                        </small>


                        <!-- ENREGISTRER -->

                        <button
                            type="submit"
                            class="btn-primary"
                            style="margin-top: 20px;"
                        >
                            Enregistrer les modifications
                        </button>

                    </form>


                    <!-- =========================
                         SUPPRIMER
                    ========================== -->

                    <form
                        action="/admin-vdp/events/<%= event._id %>/delete"
                        method="POST"
                        onsubmit="return confirm('Voulez-vous vraiment supprimer cet événement ?');"
                        style="margin-top: 10px;"
                    >

                        <button
                            type="submit"
                            class="btn-danger"
                        >
                            Supprimer
                        </button>

                    </form>

                </div>

            <% }) %>

        <% } else { %>

            <p>
                Aucun événement pour le moment.
            </p>

        <% } %>

    </div>

</section>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

document.addEventListener('DOMContentLoaded', function () {

    /* =========================================================
       ÉLÉMENTS — AJOUT D'UN ÉVÉNEMENT
    ========================================================= */

    const dateType =
        document.getElementById('dateType');

    const singleDateSection =
        document.getElementById('singleDateSection');

    const multipleDatesSection =
        document.getElementById('multipleDatesSection');

    const rangeDateSection =
        document.getElementById('rangeDateSection');

    const singleDate =
        document.getElementById('singleDate');

    const startDate =
        document.getElementById('startDate');

    const endDate =
        document.getElementById('endDate');

    const datesContainer =
        document.getElementById('datesContainer');

    const addDateButton =
        document.getElementById('addDateButton');

    const addEventForm =
        document.querySelector('form[action="/admin-vdp/events"]');


    /* =========================================================
       SÉCURITÉ
    ========================================================= */

    if (
        dateType &&
        singleDateSection &&
        multipleDatesSection &&
        rangeDateSection &&
        singleDate &&
        startDate &&
        endDate &&
        datesContainer &&
        addEventForm
    ) {


        /* =====================================================
           RÉCUPÉRER LES CHAMPS DE DATES MULTIPLES
        ===================================================== */

        function getMultipleDateInputs() {

            return Array.from(
                datesContainer.querySelectorAll(
                    'input[name="multipleDates"]'
                )
            );

        }


        /* =====================================================
           VÉRIFIER S'IL Y A UNE DATE VIDE
        ===================================================== */

        function hasEmptyDateInput() {

            const inputs =
                getMultipleDateInputs();

            return inputs.some(input => {
                return input.value === '';
            });

        }


        /* =====================================================
           METTRE À JOUR LES SECTIONS
        ===================================================== */

        function updateDateSections() {

            const selectedType =
                dateType.value;


            /* Cacher toutes les sections */

            singleDateSection.style.display =
                'none';

            multipleDatesSection.style.display =
                'none';

            rangeDateSection.style.display =
                'none';


            /* Retirer required partout */

            singleDate.required =
                false;

            startDate.required =
                false;

            endDate.required =
                false;


            /* DATE SIMPLE */

            if (selectedType === 'single') {

                singleDateSection.style.display =
                    'block';

                singleDate.required =
                    true;

            }


            /* PLUSIEURS DATES */

            if (selectedType === 'multiple') {

                multipleDatesSection.style.display =
                    'block';

            }


            /* PÉRIODE CONTINUE */

            if (selectedType === 'range') {

                rangeDateSection.style.display =
                    'block';

                startDate.required =
                    true;

                endDate.required =
                    true;

            }

        }


        /* =====================================================
           CHANGEMENT DU FORMAT DE DATE
        ===================================================== */

        dateType.addEventListener(
            'change',
            function () {

                updateDateSections();

            }
        );


        /* =====================================================
           CRÉER UNE LIGNE DE DATE
        ===================================================== */

        function createDateRow() {

            const dateRow =
                document.createElement('div');

            dateRow.className =
                'event-date-row';


            /* Champ de date */

            const dateInput =
                document.createElement('input');

            dateInput.type =
                'date';

            dateInput.name =
                'multipleDates';


            /* Pas required pour permettre
               l'ajout progressif */

            dateInput.required =
                false;


            /* Bouton supprimer */

            const removeButton =
                document.createElement('button');

            removeButton.type =
                'button';

            removeButton.className =
                'remove-date-button';

            removeButton.innerHTML =
                '&times;';

            removeButton.setAttribute(
                'aria-label',
                'Supprimer cette date'
            );


            /* Suppression */

            removeButton.addEventListener(
                'click',
                function () {

                    dateRow.remove();

                }
            );


            /* Ajouter automatiquement
               une nouvelle ligne */

            dateInput.addEventListener(
                'change',
                function () {

                    if (!dateInput.value) {
                        return;
                    }


                    const inputs =
                        getMultipleDateInputs();

                    const lastInput =
                        inputs[inputs.length - 1];


                    if (
                        dateType.value === 'multiple' &&
                        dateInput === lastInput &&
                        !hasEmptyDateInput()
                    ) {

                        createDateRow();

                    }

                }
            );


            dateRow.appendChild(
                dateInput
            );

            dateRow.appendChild(
                removeButton
            );

            datesContainer.appendChild(
                dateRow
            );


            return dateInput;

        }


        /* =====================================================
           BOUTON + AJOUTER UNE DATE
        ===================================================== */

        if (addDateButton) {

            addDateButton.addEventListener(
                'click',
                function () {

                    if (!hasEmptyDateInput()) {

                        createDateRow();

                    }

                }
            );

        }


        /* =====================================================
           VÉRIFIER LA PÉRIODE
        ===================================================== */

        endDate.addEventListener(
            'change',
            function () {

                if (
                    startDate.value &&
                    endDate.value &&
                    endDate.value < startDate.value
                ) {

                    alert(
                        'La date de fin ne peut pas être avant la date de début.'
                    );

                    endDate.value = '';

                }

            }
        );


        /* =====================================================
           INITIALISATION
        ===================================================== */

        updateDateSections();


        /* =====================================================
           AVANT L'ENVOI DU FORMULAIRE
        ===================================================== */

        addEventForm.addEventListener(
            'submit',
            function (submitEvent) {

                /*
                    Supprimer les anciens champs cachés
                */

                addEventForm
                    .querySelectorAll(
                        '.generated-date-input'
                    )
                    .forEach(function (input) {

                        input.remove();

                    });


                const selectedType =
                    dateType.value;


                /* =================================================
                   AJOUTER UNE DATE CACHÉE
                ================================================= */

                function addHiddenDate(value) {

                    if (!value) {
                        return;
                    }


                    const hiddenInput =
                        document.createElement('input');

                    hiddenInput.type =
                        'hidden';

                    hiddenInput.name =
                        'dates';

                    hiddenInput.value =
                        value;

                    hiddenInput.className =
                        'generated-date-input';

                    addEventForm.appendChild(
                        hiddenInput
                    );

                }


                /* =================================================
                   DATE SIMPLE
                ================================================= */

                if (
                    selectedType === 'single'
                ) {

                    if (!singleDate.value) {

                        submitEvent.preventDefault();

                        alert(
                            'Veuillez sélectionner une date.'
                        );

                        return;

                    }


                    addHiddenDate(
                        singleDate.value
                    );

                }


                /* =================================================
                   PLUSIEURS DATES
                ================================================= */

                if (
                    selectedType === 'multiple'
                ) {

                    const inputs =
                        getMultipleDateInputs();


                    const selectedDates =
                        inputs.filter(function (input) {

                            return input.value !== '';

                        });


                    if (
                        selectedDates.length === 0
                    ) {

                        submitEvent.preventDefault();

                        alert(
                            'Veuillez sélectionner au moins une date.'
                        );

                        return;

                    }


                    selectedDates.forEach(
                        function (input) {

                            addHiddenDate(
                                input.value
                            );

                        }
                    );

                }


                /* =================================================
                   PÉRIODE CONTINUE
                ================================================= */

                if (
                    selectedType === 'range'
                ) {

                    if (
                        !startDate.value ||
                        !endDate.value
                    ) {

                        submitEvent.preventDefault();

                        alert(
                            'Veuillez sélectionner une date de début et une date de fin.'
                        );

                        return;

                    }


                    const start =
                        new Date(
                            startDate.value +
                            'T00:00:00'
                        );

                    const end =
                        new Date(
                            endDate.value +
                            'T00:00:00'
                        );


                    if (end < start) {

                        submitEvent.preventDefault();

                        alert(
                            'La date de fin ne peut pas être avant la date de début.'
                        );

                        return;

                    }


                    /*
                        Ajouter toutes les journées
                        entre le début et la fin.
                    */

                    const current =
                        new Date(start);


                    while (
                        current <= end
                    ) {

                        const year =
                            current.getFullYear();

                        const month =
                            String(
                                current.getMonth() + 1
                            ).padStart(
                                2,
                                '0'
                            );

                        const day =
                            String(
                                current.getDate()
                            ).padStart(
                                2,
                                '0'
                            );


                        addHiddenDate(
                            `${year}-${month}-${day}`
                        );


                        current.setDate(
                            current.getDate() + 1
                        );

                    }

                }

            }
        );

    }



    /* =========================================================
       MODIFICATION DES ÉVÉNEMENTS EXISTANTS
    ========================================================= */

    const editDateButtons =
        document.querySelectorAll(
            '.add-edit-date-button'
        );


    editDateButtons.forEach(
        function (button) {

            button.addEventListener(
                'click',
                function () {

                    const eventId =
                        button.dataset.eventId;

                    const container =
                        document.getElementById(
                            `edit-dates-${eventId}`
                        );


                    if (!container) {
                        return;
                    }


                    /* Créer une nouvelle ligne */

                    const row =
                        document.createElement('div');

                    row.className =
                        'event-date-row';


                    /* Champ date */

                    const input =
                        document.createElement('input');

                    input.type =
                        'date';

                    input.name =
                        'dates';

                    input.required =
                        true;


                    /* Bouton supprimer */

                    const removeButton =
                        document.createElement('button');

                    removeButton.type =
                        'button';

                    removeButton.className =
                        'remove-date-button';

                    removeButton.innerHTML =
                        '&times;';

                    removeButton.setAttribute(
                        'aria-label',
                        'Supprimer cette date'
                    );


                    removeButton.addEventListener(
                        'click',
                        function () {

                            /*
                                Empêcher la suppression
                                de la dernière date.
                            */

                            const rows =
                                container.querySelectorAll(
                                    '.event-date-row'
                                );

                            if (rows.length <= 1) {

                                alert(
                                    'Un événement doit avoir au moins une date.'
                                );

                                return;

                            }

                            row.remove();

                        }
                    );


                    row.appendChild(
                        input
                    );

                    row.appendChild(
                        removeButton
                    );


                    container.appendChild(
                        row
                    );

                    input.focus();

                }
            );

        }
    );



    /* =========================================================
       BOUTONS X DES DATES EXISTANTES
    ========================================================= */

    const existingRemoveButtons =
        document.querySelectorAll(
            '.event-edit-form .remove-date-button'
        );


    existingRemoveButtons.forEach(
        function (button) {

            button.addEventListener(
                'click',
                function () {

                    const row =
                        button.closest(
                            '.event-date-row'
                        );

                    const container =
                        button.closest(
                            '.edit-dates-container'
                        );


                    if (!row || !container) {
                        return;
                    }


                    const rows =
                        container.querySelectorAll(
                            '.event-date-row'
                        );


                    /*
                        Empêcher de supprimer
                        la dernière date.
                    */

                    if (rows.length <= 1) {

                        alert(
                            'Un événement doit avoir au moins une date.'
                        );

                        return;

                    }


                    row.remove();

                }
            );

        }
    );

});

</script>