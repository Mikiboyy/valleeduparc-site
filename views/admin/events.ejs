<section class="form-section">

    <!-- =========================
         AJOUTER UN ÉVÉNEMENT
    ========================== -->

    <form
        action="/admin-vdp/events"
        method="POST"
        enctype="multipart/form-data"
        class="course-form"
    >

        <h2>Ajouter un événement</h2>


        <!-- TITRE -->

        <label for="title">
            Titre
        </label>

        <input
            type="text"
            id="title"
            name="title"
            required
        >


        <!-- DESCRIPTION -->

        <label for="description">
            Description
        </label>

        <textarea
            id="description"
            name="description"
            required
        ></textarea>


        <!-- =========================
             TYPE DE DATE
        ========================== -->

        <label>
            Format des dates
        </label>

        <p
            style="
                font-size: 14px;
                margin-top: 0;
                margin-bottom: 15px;
            "
        >
            Choisissez comment les dates de l'événement doivent être ajoutées.
        </p>


        <select
            id="dateType"
            name="dateType"
            style="margin-bottom: 20px;"
        >

            <option value="single">
                Une seule date
            </option>

            <option value="multiple">
                Plusieurs dates séparées
            </option>

            <option value="range">
                Plusieurs jours consécutifs
            </option>

        </select>


        <!-- =========================
             DATE SIMPLE
        ========================== -->

        <div
            id="singleDateSection"
            class="date-section"
        >

            <label for="singleDate">
                Date de l'événement
            </label>

            <input
                type="date"
                id="singleDate"
                name="singleDate"
            >

        </div>


        <!-- =========================
             PLUSIEURS DATES
        ========================== -->

        <div
            id="multipleDatesSection"
            class="date-section"
            style="display: none;"
        >

            <label>
                Dates de l'événement
            </label>

            <p
                style="
                    font-size: 14px;
                    margin-top: 0;
                    margin-bottom: 15px;
                "
            >
                Ajoutez toutes les dates où l'événement aura lieu.
            </p>


            <div id="datesContainer">

                <div class="event-date-row">

                    <input
                        type="date"
                        name="multipleDates"
                    >

                </div>

            </div>


            <button
                type="button"
                id="addDateButton"
                class="btn-secondary"
                style="margin-top: 15px;"
            >
                + Ajouter une date
            </button>

        </div>


        <!-- =========================
             PÉRIODE CONTINUE
        ========================== -->

        <div
            id="rangeDateSection"
            class="date-section"
            style="display: none;"
        >

            <label for="startDate">
                Date de début
            </label>

            <input
                type="date"
                id="startDate"
                name="startDate"
            >


            <label
                for="endDate"
                style="margin-top: 15px;"
            >
                Date de fin
            </label>

            <input
                type="date"
                id="endDate"
                name="endDate"
            >

            <p
                style="
                    font-size: 14px;
                    margin-top: 10px;
                "
            >
                Toutes les journées entre la date de début et la date de fin seront automatiquement ajoutées.
            </p>

        </div>


        <!-- LIEU -->

        <label
            for="location"
            style="margin-top: 25px;"
        >
            Lieu
        </label>

        <input
            type="text"
            id="location"
            name="location"
        >


        <!-- IMAGE -->

        <label for="image">
            Image
        </label>

        <input
            type="file"
            id="image"
            name="image"
            accept="image/*"
        >


        <!-- BOUTON -->

        <button
            type="submit"
            class="btn-primary"
            style="margin-top: 25px;"
        >
            Ajouter l'événement
        </button>

    </form>



    <!-- =========================
         ÉVÉNEMENTS EXISTANTS
    ========================== -->

    <div
        class="course-form"
        style="margin-top: 30px;"
    >

        <h2>
            Événements existants
        </h2>


        <% if (events && events.length > 0) { %>

            <% events.forEach(event => { %>

                <div class="admin-row">

                    <div>

                        <strong>
                            <%= event.title %>
                        </strong>


                        <!-- AFFICHAGE DES DATES -->

                        <% if (event.dates && event.dates.length > 0) { %>

                            <div
                                style="
                                    margin-top: 8px;
                                    font-size: 14px;
                                "
                            >

                                <% event.dates.forEach((date, index) => { %>

                                    <span>

                                        <%= new Date(date).toLocaleDateString(
                                            'fr-CA',
                                            {
                                                year: 'numeric',
                                                month: 'long',
                                                day: 'numeric'
                                            }
                                        ) %>

                                        <% if (index < event.dates.length - 1) { %>
                                            <br>
                                        <% } %>

                                    </span>

                                <% }) %>

                            </div>

                        <% } else { %>

                            <span>
                                Aucune date
                            </span>

                        <% } %>

                    </div>


                    <!-- SUPPRESSION -->

                    <form
                        action="/admin-vdp/events/<%= event._id %>/delete"
                        method="POST"
                    >

                        <button type="submit">
                            Supprimer
                        </button>

                    </form>

                </div>

            <% }) %>

        <% } else { %>

            <p>
                Aucun événement pour le moment.
            </p>

        <% } %>

    </div>

</section>



<!-- =========================
     JAVASCRIPT
========================= -->

<script>

document.addEventListener('DOMContentLoaded', function () {

    /*
        ÉLÉMENTS
    */

    const dateType =
        document.getElementById('dateType');

    const singleDateSection =
        document.getElementById('singleDateSection');

    const multipleDatesSection =
        document.getElementById('multipleDatesSection');

    const rangeDateSection =
        document.getElementById('rangeDateSection');

    const singleDate =
        document.getElementById('singleDate');

    const startDate =
        document.getElementById('startDate');

    const endDate =
        document.getElementById('endDate');

    const datesContainer =
        document.getElementById('datesContainer');

    const addDateButton =
        document.getElementById('addDateButton');


    /*
        CHANGER LE TYPE DE DATE
    */

    function updateDateSections() {

        const selectedType =
            dateType.value;


        /*
            Cacher toutes les sections
        */

        singleDateSection.style.display =
            'none';

        multipleDatesSection.style.display =
            'none';

        rangeDateSection.style.display =
            'none';


        /*
            Enlever required partout
        */

        singleDate.required =
            false;

        startDate.required =
            false;

        endDate.required =
            false;


        const multipleDateInputs =
            datesContainer.querySelectorAll(
                'input[name="multipleDates"]'
            );

        multipleDateInputs.forEach(input => {

            input.required =
                false;

        });


        /*
            DATE SIMPLE
        */

        if (selectedType === 'single') {

            singleDateSection.style.display =
                'block';

            singleDate.required =
                true;

        }


        /*
            PLUSIEURS DATES
        */

        if (selectedType === 'multiple') {

            multipleDatesSection.style.display =
                'block';


            const firstDateInput =
                datesContainer.querySelector(
                    'input[name="multipleDates"]'
                );

            if (firstDateInput) {

                firstDateInput.required =
                    true;

            }

        }


        /*
            PÉRIODE CONTINUE
        */

        if (selectedType === 'range') {

            rangeDateSection.style.display =
                'block';

            startDate.required =
                true;

            endDate.required =
                true;

        }

    }


    /*
        ÉVÉNEMENT CHANGEMENT TYPE
    */

    dateType.addEventListener(
        'change',
        function () {

            updateDateSections();

        }
    );


    /*
        AJOUTER UNE DATE
    */

    function createDateRow(autoFocus = false) {

        /*
            Créer la ligne
        */

        const dateRow =
            document.createElement('div');

        dateRow.className =
            'event-date-row';


        /*
            Permet au champ et au bouton ×
            d'être côte à côte
        */

        dateRow.style.display =
            'flex';

        dateRow.style.alignItems =
            'center';

        dateRow.style.gap =
            '10px';

        dateRow.style.width =
            '100%';


        /*
            CHAMP DATE
        */

        const dateInput =
            document.createElement('input');

        dateInput.type =
            'date';

        dateInput.name =
            'multipleDates';

        dateInput.required =
            false;

        dateInput.style.flex =
            '1';

        dateInput.style.minWidth =
            '0';


        /*
            BOUTON SUPPRIMER
        */

        const removeButton =
            document.createElement('button');

        removeButton.type =
            'button';

        removeButton.className =
            'remove-date-button';

        removeButton.innerHTML =
            '&times;';

        removeButton.setAttribute(
            'aria-label',
            'Supprimer cette date'
        );

        removeButton.style.flexShrink =
            '0';


        /*
            SUPPRIMER LA DATE
        */

        removeButton.addEventListener(
            'click',
            function () {

                const rows =
                    datesContainer.querySelectorAll(
                        '.event-date-row'
                    );


                /*
                    Garder au moins un champ
                */

                if (rows.length <= 1) {

                    dateInput.value =
                        '';

                    return;

                }


                dateRow.remove();


                /*
                    Mettre le premier champ
                    restant en required
                */

                const remainingInputs =
                    datesContainer.querySelectorAll(
                        'input[name="multipleDates"]'
                    );

                remainingInputs.forEach(
                    (input, index) => {

                        input.required =
                            index === 0;

                    }
                );

            }
        );


        /*
            AJOUTER AUTOMATIQUEMENT
            UN NOUVEAU CHAMP APRÈS
            LA SÉLECTION D'UNE DATE
        */

        dateInput.addEventListener(
            'change',
            function () {

                /*
                    Si aucune date,
                    ne rien faire
                */

                if (!dateInput.value) {

                    return;

                }


                const rows =
                    datesContainer.querySelectorAll(
                        '.event-date-row'
                    );


                /*
                    Vérifier si cette ligne
                    est la dernière
                */

                const lastRow =
                    rows[rows.length - 1];


                /*
                    Si oui, créer immédiatement
                    le prochain champ vide

                    IMPORTANT :
                    false empêche le nouveau
                    champ de voler le focus
                    et de causer un bug avec
                    le calendrier.
                */

                if (dateRow === lastRow) {

                    createDateRow(false);

                }

            }
        );


        /*
            AJOUTER LES ÉLÉMENTS
        */

        dateRow.appendChild(
            dateInput
        );

        dateRow.appendChild(
            removeButton
        );

        datesContainer.appendChild(
            dateRow
        );


        /*
            Donner le focus seulement
            lorsqu'on ajoute manuellement
            une nouvelle date.

            Cela évite le bug lorsque
            le champ est créé automatiquement.
        */

        if (autoFocus) {

            dateInput.focus();

        }

    }


    /*
        BOUTON AJOUTER DATE
    */

    addDateButton.addEventListener(
        'click',
        function () {

            /*
                true = donner le focus
                puisque l'utilisateur
                a volontairement ajouté
                une nouvelle date
            */

            createDateRow(true);

        }
    );


    /*
        VÉRIFIER LA PÉRIODE

        La date de fin ne peut pas être
        avant la date de début.
    */

    endDate.addEventListener(
        'change',
        function () {

            if (
                startDate.value &&
                endDate.value &&
                endDate.value < startDate.value
            ) {

                alert(
                    'La date de fin ne peut pas être avant la date de début.'
                );

                endDate.value =
                    '';

            }

        }
    );


    /*
        INITIALISATION
    */

    updateDateSections();


    /*
        AVANT L'ENVOI DU FORMULAIRE

        On transforme les dates sélectionnées
        en champs "dates" pour que le backend
        puisse les recevoir correctement.
    */

    document.querySelector('.course-form')
        .addEventListener(
            'submit',
            function (event) {


                /*
                    Supprimer les anciens
                    champs dates générés
                */

                document.querySelectorAll(
                    '.generated-date-input'
                ).forEach(input => {

                    input.remove();

                });


                const selectedType =
                    dateType.value;

                const form =
                    event.target;


                /*
                    FONCTION POUR AJOUTER
                    UNE DATE AU FORMULAIRE
                */

                function addHiddenDate(value) {

                    if (!value) {

                        return;

                    }


                    const hiddenInput =
                        document.createElement('input');

                    hiddenInput.type =
                        'hidden';

                    hiddenInput.name =
                        'dates';

                    hiddenInput.value =
                        value;

                    hiddenInput.className =
                        'generated-date-input';

                    form.appendChild(
                        hiddenInput
                    );

                }


                /*
                    DATE SIMPLE
                */

                if (
                    selectedType === 'single'
                ) {

                    addHiddenDate(
                        singleDate.value
                    );

                }


                /*
                    PLUSIEURS DATES
                */

                if (
                    selectedType === 'multiple'
                ) {

                    const inputs =
                        datesContainer.querySelectorAll(
                            'input[name="multipleDates"]'
                        );


                    inputs.forEach(input => {

                        addHiddenDate(
                            input.value
                        );

                    });

                }


                /*
                    PÉRIODE CONTINUE
                */

                if (
                    selectedType === 'range'
                ) {

                    if (
                        startDate.value &&
                        endDate.value
                    ) {

                        const start =
                            new Date(
                                startDate.value +
                                'T00:00:00'
                            );

                        const end =
                            new Date(
                                endDate.value +
                                'T00:00:00'
                            );


                        /*
                            Ajouter chaque journée
                            entre début et fin
                        */

                        const current =
                            new Date(start);


                        while (
                            current <= end
                        ) {

                            const year =
                                current.getFullYear();

                            const month =
                                String(
                                    current.getMonth() + 1
                                ).padStart(
                                    2,
                                    '0'
                                );

                            const day =
                                String(
                                    current.getDate()
                                ).padStart(
                                    2,
                                    '0'
                                );


                            addHiddenDate(
                                `${year}-${month}-${day}`
                            );


                            current.setDate(
                                current.getDate() + 1
                            );

                        }

                    }

                }

            }
        );

});

</script>