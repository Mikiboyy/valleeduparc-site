<section class="admin-section">

    <h1>Gestion du FAQ</h1>


    <!-- =========================
         AJOUTER UNE QUESTION
    ========================== -->

    <div class="admin-card">

        <h2>Ajouter une question</h2>

        <form
            action="/admin-vdp/faq"
            method="POST"
            class="admin-form"
        >

            <div class="form-group">

                <label>Catégorie</label>

                <input
                    type="text"
                    name="category"
                    placeholder="Ex : Billets"
                    required
                >

            </div>


            <div class="form-group">

                <label>Question</label>

                <input
                    type="text"
                    name="question"
                    required
                >

            </div>


            <div class="form-group">

                <label>Réponse</label>

                <textarea
                    name="answer"
                    rows="5"
                    required
                ></textarea>

            </div>


            <div class="form-group">

                <label>Ordre d'affichage</label>

                <input
                    type="number"
                    name="order"
                    value="0"
                >

            </div>


            <div class="form-group checkbox-group">

                <label>

                    <input
                        type="checkbox"
                        name="isActive"
                        checked
                    >

                    Question active

                </label>

            </div>


            <button
                type="submit"
                class="btn-primary"
            >

                AJOUTER LA QUESTION

            </button>

        </form>

    </div>


    <!-- =========================
         LISTE DES QUESTIONS
    ========================== -->

    <% if (faqs && faqs.length > 0) { %>

        <% faqs.forEach(faq => { %>

            <div class="admin-card faq-admin-card">

                <form
                    action="/admin-vdp/faq/<%= faq._id %>"
                    method="POST"
                    class="admin-form"
                >

                    <div class="form-group">

                        <label>Catégorie</label>

                        <input
                            type="text"
                            name="category"
                            value="<%= faq.category %>"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>Question</label>

                        <input
                            type="text"
                            name="question"
                            value="<%= faq.question %>"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>Réponse</label>

                        <textarea
                            name="answer"
                            rows="5"
                            required
                        ><%= faq.answer %></textarea>

                    </div>


                    <div class="form-group">

                        <label>Ordre</label>

                        <input
                            type="number"
                            name="order"
                            value="<%= faq.order %>"
                        >

                    </div>


                    <div class="form-group checkbox-group">

                        <label>

                            <input
                                type="checkbox"
                                name="isActive"
                                <%= faq.isActive ? 'checked' : '' %>
                            >

                            Active

                        </label>

                    </div>


                    <button
                        type="submit"
                        class="btn-primary"
                    >

                        ENREGISTRER

                    </button>

                </form>


                <form
                    action="/admin-vdp/faq/<%= faq._id %>/delete"
                    method="POST"
                    onsubmit="return confirm('Voulez-vous vraiment supprimer cette question?');"
                >

                    <button
                        type="submit"
                        class="btn-danger"
                    >

                        SUPPRIMER

                    </button>

                </form>

            </div>

        <% }) %>

    <% } else { %>

        <p>
            Aucune question dans le FAQ pour le moment.
        </p>

    <% } %>

</section>