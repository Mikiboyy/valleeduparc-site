<section class="admin-section">

    <div class="admin-page-header">
        <div>
            <span class="admin-page-subtitle">
                ADMINISTRATION
            </span>

            <h1>Gestion du FAQ</h1>

            <p>
                Ajoutez, modifiez ou supprimez les questions
                affichées sur la page FAQ.
            </p>
        </div>
    </div>


    <!-- =========================
         AJOUTER UNE QUESTION
    ========================== -->

    <div class="admin-card faq-add-card">

        <div class="admin-card-header">

            <div>
                <h2>Ajouter une question</h2>

                <p>
                    Créez une nouvelle question pour le FAQ.
                </p>
            </div>

        </div>


        <form
            action="/admin-vdp/faq"
            method="POST"
            class="admin-form faq-admin-form"
        >

            <div class="faq-form-grid">


                <!-- CATÉGORIE -->

                <div class="form-group">

                    <label for="category">
                        Catégorie
                    </label>

                    <select
                        id="category"
                        name="category"
                        required
                    >

                        <option value="">
                            Sélectionner une catégorie
                        </option>

                        <option value="abonnements">
                            Infos abonnements
                        </option>

                        <option value="montagne">
                            Montagne et pistes
                        </option>

                        <option value="horaire">
                            Horaire et nous joindre
                        </option>

                    </select>

                </div>


                <!-- ORDRE -->

                <div class="form-group">

                    <label for="order">
                        Ordre d'affichage
                    </label>

                    <input
                        id="order"
                        type="number"
                        name="order"
                        value="0"
                    >

                </div>

            </div>


            <!-- QUESTION -->

            <div class="form-group">

                <label for="question">
                    Question
                </label>

                <input
                    id="question"
                    type="text"
                    name="question"
                    placeholder="Ex : Comment acheter un abonnement?"
                    required
                >

            </div>


            <!-- RÉPONSE -->

            <div class="form-group">

                <label for="answer">
                    Réponse
                </label>

                <textarea
                    id="answer"
                    name="answer"
                    rows="6"
                    placeholder="Écrivez la réponse ici..."
                    required
                ></textarea>

            </div>


            <!-- ACTIVE -->

            <div class="form-group checkbox-group">

                <label>

                    <input
                        type="checkbox"
                        name="isActive"
                        checked
                    >

                    <span>
                        Question active
                    </span>

                </label>

            </div>


            <div class="faq-form-actions">

                <button
                    type="submit"
                    class="btn-primary"
                >
                    AJOUTER LA QUESTION
                </button>

            </div>

        </form>

    </div>


    <!-- =========================
         LISTE DES QUESTIONS
    ========================== -->

    <div class="faq-list-header">

        <div>

            <h2>
                Questions existantes
            </h2>

            <p>
                Modifiez les informations ou supprimez une question.
            </p>

        </div>


        <div class="faq-count">

            <%= faqs ? faqs.length : 0 %>
            question<%= faqs && faqs.length !== 1 ? 's' : '' %>

        </div>

    </div>


    <% if (faqs && faqs.length > 0) { %>


        <div class="faq-admin-list">


            <% faqs.forEach((faq, index) => { %>


                <div class="admin-card faq-admin-card">


                    <!-- EN-TÊTE CARTE -->

                    <div class="faq-card-header">

                        <div class="faq-card-number">

                            <%= index + 1 %>

                        </div>


                        <div class="faq-card-title">

                            <h3>
                                <%= faq.question %>
                            </h3>

                            <span class="faq-category-badge">

                                <% if (faq.category === 'abonnements') { %>

                                    Infos abonnements

                                <% } else if (faq.category === 'montagne') { %>

                                    Montagne et pistes

                                <% } else if (faq.category === 'horaire') { %>

                                    Horaire et nous joindre

                                <% } else { %>

                                    <%= faq.category %>

                                <% } %>

                            </span>

                        </div>


                        <div
                            class="
                                faq-status
                                <%= faq.isActive
                                    ? 'status-active'
                                    : 'status-inactive'
                                %>
                            "
                        >

                            <%= faq.isActive
                                ? 'Active'
                                : 'Inactive'
                            %>

                        </div>

                    </div>


                    <!-- FORMULAIRE MODIFICATION -->

                    <form
                        action="/admin-vdp/faq/<%= faq._id %>"
                        method="POST"
                        class="admin-form faq-admin-form"
                    >


                        <div class="faq-form-grid">


                            <!-- CATÉGORIE -->

                            <div class="form-group">

                                <label>
                                    Catégorie
                                </label>

                                <select
                                    name="category"
                                    required
                                >

                                    <option
                                        value="abonnements"
                                        <%= faq.category === 'abonnements'
                                            ? 'selected'
                                            : ''
                                        %>
                                    >
                                        Infos abonnements
                                    </option>


                                    <option
                                        value="montagne"
                                        <%= faq.category === 'montagne'
                                            ? 'selected'
                                            : ''
                                        %>
                                    >
                                        Montagne et pistes
                                    </option>


                                    <option
                                        value="horaire"
                                        <%= faq.category === 'horaire'
                                            ? 'selected'
                                            : ''
                                        %>
                                    >
                                        Horaire et nous joindre
                                    </option>

                                </select>

                            </div>


                            <!-- ORDRE -->

                            <div class="form-group">

                                <label>
                                    Ordre d'affichage
                                </label>

                                <input
                                    type="number"
                                    name="order"
                                    value="<%= faq.order %>"
                                >

                            </div>


                        </div>


                        <!-- QUESTION -->

                        <div class="form-group">

                            <label>
                                Question
                            </label>

                            <input
                                type="text"
                                name="question"
                                value="<%= faq.question %>"
                                required
                            >

                        </div>


                        <!-- RÉPONSE -->

                        <div class="form-group">

                            <label>
                                Réponse
                            </label>

                            <textarea
                                name="answer"
                                rows="6"
                                required
                            ><%= faq.answer %></textarea>

                        </div>


                        <!-- ACTIVE -->

                        <div class="form-group checkbox-group">

                            <label>

                                <input
                                    type="checkbox"
                                    name="isActive"
                                    <%= faq.isActive
                                        ? 'checked'
                                        : ''
                                    %>
                                >

                                <span>
                                    Question active
                                </span>

                            </label>

                        </div>


                        <!-- ACTIONS -->

                        <div class="faq-card-actions">

                            <button
                                type="submit"
                                class="btn-primary"
                            >
                                ENREGISTRER LES MODIFICATIONS
                            </button>

                        </div>

                    </form>


                    <!-- SUPPRESSION -->

                    <form
                        action="/admin-vdp/faq/<%= faq._id %>/delete"
                        method="POST"
                        class="faq-delete-form"
                        onsubmit="return confirm('Voulez-vous vraiment supprimer cette question?');"
                    >

                        <button
                            type="submit"
                            class="btn-danger"
                        >
                            SUPPRIMER LA QUESTION
                        </button>

                    </form>


                </div>


            <% }) %>


        </div>


    <% } else { %>


        <div class="admin-card faq-empty-state">

            <h3>
                Aucune question
            </h3>

            <p>
                Il n'y a aucune question dans le FAQ pour le moment.
            </p>

        </div>


    <% } %>


</section>