<section class="form-section">

    <!-- =========================
         AJOUTER UN POSTE
    ========================== -->

    <form 
        action="/admin-vdp/jobs" 
        method="POST" 
        enctype="multipart/form-data" 
        class="course-form"
    >

        <h2>Ajouter un poste</h2>


        <!-- TITRE -->

        <label for="title">
            Titre du poste
        </label>

        <input 
            type="text" 
            id="title"
            name="title" 
            required
        >


        <!-- DÉPARTEMENT -->

        <label for="department">
            Département
        </label>

        <input 
            type="text" 
            id="department"
            name="department" 
            required
        >


        <!-- RÉSUMÉ -->

        <label for="summary">
            Résumé
        </label>

        <textarea
            id="summary"
            name="summary"
            placeholder="Courte description du poste"
            required
        ></textarea>


        <!-- DÉTAILS -->

        <label for="details">
            Détails du poste
        </label>

        <p style="font-size: 14px;">
            Écris un élément par ligne.
        </p>

        <textarea
            id="details"
            name="details"
            rows="10"
        ></textarea>


        <!-- IMAGE -->

        <label for="image">
            Image
        </label>

        <input 
            type="file" 
            id="image"
            name="image" 
            accept="image/*"
        >


        <!-- ACTIF -->

        <label>
            <input 
                type="checkbox" 
                name="isActive" 
                checked
            >

            Actif
        </label>


        <!-- BOUTON -->

        <button 
            type="submit" 
            class="btn-primary"
        >
            Ajouter le poste
        </button>

    </form>



    <!-- =========================
         POSTES EXISTANTS
    ========================== -->

    <div 
        class="course-form" 
        style="margin-top:30px;"
    >

        <h2>Postes existants</h2>


        <% jobs.forEach(job => { %>


            <!-- MODIFIER LE POSTE -->

            <form 
                action="/admin-vdp/jobs/<%= job._id %>" 
                method="POST" 
                class="admin-price-row"
            >


                <!-- TITRE -->

                <label>
                    Titre
                </label>

                <input 
                    type="text" 
                    name="title" 
                    value="<%= job.title %>"
                    required
                >


                <!-- DÉPARTEMENT -->

                <label>
                    Département
                </label>

                <input 
                    type="text" 
                    name="department" 
                    value="<%= job.department %>"
                    required
                >


                <!-- RÉSUMÉ -->

                <label>
                    Résumé
                </label>

                <textarea 
                    name="summary"
                    required
                ><%= job.summary %></textarea>


                <!-- DÉTAILS -->

                <label>
                    Détails du poste
                </label>

                <p style="font-size: 14px;">
                    Un élément par ligne.
                </p>

                <textarea 
                    name="details"
                    rows="10"
                    placeholder="Un élément par ligne"
                ><%= job.details && job.details.length > 0 ? job.details.join('\n') : '' %></textarea>


                <!-- ACTIF -->

                <label>

                    <input 
                        type="checkbox" 
                        name="isActive" 
                        <%= job.isActive ? 'checked' : '' %>
                    >

                    Actif

                </label>


                <!-- ENREGISTRER -->

                <button type="submit">
                    Enregistrer
                </button>


            </form>


            <!-- =========================
                 SUPPRIMER LE POSTE
            ========================== -->

            <form 
                action="/admin-vdp/jobs/<%= job._id %>/delete" 
                method="POST"
                onsubmit="return confirm('Voulez-vous vraiment supprimer ce poste?');"
            >

                <button type="submit">
                    Supprimer
                </button>

            </form>


            <hr style="margin: 30px 0;">


        <% }) %>


    </div>

</section>