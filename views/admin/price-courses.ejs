<section class="form-section">
    <div class="course-form">
        <h2>Prix cours</h2>

        <% courses.forEach(course => { %>
            <form action="/admin-vdp/prices/cours/<%= course._id %>" method="POST" class="admin-price-row">
                <strong><%= course.season %> — <%= course.title %> — <%= course.category %></strong>

                <label>Prix</label>
                <input type="number" step="0.01" name="price" value="<%= course.price ?? '' %>">

                <label>Texte spécial</label>
                <input type="text" name="priceLabel" value="<%= course.priceLabel || '' %>">

                <label>
                    <input type="checkbox" name="isActive" <%= course.isActive ? 'checked' : '' %>>
                    Actif
                </label>

                <button type="submit">Enregistrer</button>
            </form>
        <% }) %>
    </div>
</section>