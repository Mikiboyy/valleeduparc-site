<section class="form-section">
    <div class="course-form">
        <h2>Prix location</h2>

        <% items.forEach(item => { %>
            <form action="/admin-vdp/prices/location/<%= item._id %>" method="POST" class="admin-price-row">
                <strong>
                    <%= item.category %> —
                    <%= item.subCategory %> —
                    <%= item.name %> —
                    <%= item.ageGroup %> —
                    <%= item.period %>
                </strong>

                <label>Prix</label>
                <input type="number" step="0.01" name="price" value="<%= item.price ?? '' %>">

                <label>
                    <input type="checkbox" name="isActive" <%= item.isActive ? 'checked' : '' %>>
                    Actif
                </label>

                <button type="submit">Enregistrer</button>
            </form>
        <% }) %>
    </div>
</section>