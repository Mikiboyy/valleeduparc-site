<section class="form-section">
    <div class="course-form">
        <h2>Prix abonnements</h2>

        <div class="price-admin-header">

    <div>
        <h1>Prix des abonnements</h1>
        <p>Gérer les prix des abonnements de la station.</p>
    </div>

</div>


<div class="price-add-box">

    <h2>Ajouter un abonnement</h2>

    <form
        action="/admin-vdp/prices/abonnements/add"
        method="POST"
        class="price-form"
    >

        <div class="form-group">

            <label for="category">
                Catégorie
            </label>

            <input
                type="text"
                id="category"
                name="category"
                required
                placeholder="Ex. Ski alpin"
            >

        </div>


        <div class="form-group">

            <label for="ageGroup">
                Groupe d'âge
            </label>

            <input
                type="text"
                id="ageGroup"
                name="ageGroup"
                required
                placeholder="Ex. Adulte"
            >

        </div>


        <div class="form-group">

            <label for="regularPrice">
                Prix régulier
            </label>

            <input
                type="number"
                id="regularPrice"
                name="regularPrice"
                min="0"
                step="0.01"
                placeholder="0.00"
            >

        </div>


        <div class="form-group">

            <label for="fdcPrice">
                Prix Festival des couleurs
            </label>

            <input
                type="number"
                id="fdcPrice"
                name="fdcPrice"
                min="0"
                step="0.01"
                placeholder="0.00"
            >

        </div>


        <div class="form-group">

            <label for="order">
                Ordre d'affichage
            </label>

            <input
                type="number"
                id="order"
                name="order"
                value="0"
                step="1"
            >

        </div>


        <button
            type="submit"
            class="admin-btn admin-btn-primary"
        >
            + Ajouter l'abonnement
        </button>

    </form>

</div>

        <% prices.forEach(price => { %>
            <form action="/admin-vdp/prices/abonnements/<%= price._id %>" method="POST" class="admin-price-row">
                <strong><%= price.category %> — <%= price.ageGroup %></strong>

                <label>Régulier</label>
                <input type="number" step="0.01" name="regularPrice" value="<%= price.regularPrice ?? '' %>">

                <label>FDC</label>
                <input type="number" step="0.01" name="fdcPrice" value="<%= price.fdcPrice ?? '' %>">

                <label>
                    <input type="checkbox" name="isActive" <%= price.isActive ? 'checked' : '' %>>
                    Actif
                </label>

                <button type="submit">Enregistrer</button>
            </form>
        <% }) %>
    </div>
</section>