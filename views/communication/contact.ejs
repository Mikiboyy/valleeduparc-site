<!-- HERO -->
<section class="montagne-hero contact-hero">

    <div class="montagne-overlay"></div>

    <div class="montagne-content">

        <div class="montagne-text">

            <span class="montagne-subtitle">
                CONTACT
            </span>

            <h1>
                NOUS<br>
                JOINDRE
            </h1>

            <p class="montagne-description">
                Vous pouvez nous joindre facilement en remplissant notre formulaire
                ou en nous contactant directement.
                Au plaisir de prendre contact avec vous.
            </p>

            <div class="montagne-buttons">
                <a href="#contact-formulaire" class="btn-primary">
                    ÉCRIVEZ-NOUS
                </a>

                <a href="#contact-carte" class="btn-secondary">
                    NOUS TROUVER
                </a>
            </div>

        </div>

    </div>

</section>


<!-- CONTACT INFOS + FORMULAIRE -->
<section class="boutique-section" id="contact-formulaire">

    <div class="boutique-container">

        <div class="contact-grid">

            <div class="contact-info">

                <div class="contact-item">
                    <div class="contact-icon">📍</div>

                    <div>
                        <h3>Adresse</h3>
                        <p>
                            10000, ch de la Vallée-du-Parc<br>
                            Shawinigan, Québec, G9T 0N1
                        </p>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon">✉</div>

                    <div>
                        <h3>Courriel</h3>
                        <p>
                            <a href="mailto:info@valleeduparc.com">
                                info@valleeduparc.com
                            </a>
                        </p>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon">☎</div>

                    <div>
                        <h3>Téléphone</h3>
                        <p>
                            <a href="tel:8195381639">
                                819 538-1639
                            </a>
                        </p>
                    </div>
                </div>

            </div>


            <div class="contact-form-box">

                <span class="pricing-subtitle">
                    FORMULAIRE
                </span>

                <h2>
                    Écrivez-nous
                </h2>

                <% if (success) { %>

                    <div class="form-message form-success">
                        ✓ Votre message a été envoyé avec succès. Nous vous répondrons dès que possible.
                    </div>

                    <% } %>


                    <% if (error) { %>

                        <div class="form-message form-error">
                            ✕ Une erreur est survenue lors de l'envoi du message. Veuillez réessayer.
                        </div>

                        <% } %>


                        <form action="/contact" method="POST" class="contact-form">

                            <form action="/contact" method="POST" class="contact-form">

                                <div class="form-row">
                                    <input type="text" name="name" placeholder="Votre nom" required>
                                    <input type="email" name="email" placeholder="Votre courriel" required>
                                </div>

                                <input type="text" name="subject" placeholder="Sujet" required>

                                <textarea name="message" rows="6" placeholder="Votre message" required></textarea>

                                <button type="submit" class="btn-primary">
                        ENVOYER
                    </button>

                </form>

            </div>

        </div>

    </div>

</section>


<!-- MAP -->
<section class="pricing-section" id="contact-carte">

    <div class="pricing-title">

        <span class="pricing-subtitle">
            LOCALISATION
        </span>

        <h2>
            Où nous trouver?
        </h2>

        <p>
            Le centre de ski Vallée du Parc est situé à Shawinigan,
            au cœur de la Mauricie.
        </p>

    </div>

    <div class="contact-map">
        <iframe
            src="https://www.google.com/maps?q=10000%20ch%20de%20la%20Vall%C3%A9e-du-Parc%20Shawinigan%20QC%20G9T%200N1&output=embed"
            width="100%"
            height="420"
            style="border:0;"
            allowfullscreen=""
            loading="lazy">
        </iframe>
    </div>

</section>