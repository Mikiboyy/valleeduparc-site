<!-- FAQ -->
<section class="faq-section">

    <div class="faq-container">

        <div class="section-title">
            <span>FAQ</span>
            <h2>Questions fréquentes</h2>
        </div>

        <div class="faq-tabs">

            <button class="faq-tab active" data-target="abonnements">
                Infos abonnements
            </button>

            <button class="faq-tab" data-target="montagne">
                Montagne et pistes
            </button>

            <button class="faq-tab" data-target="horaire">
                Horaire et nous joindre
            </button>

        </div>


        <!-- INFOS ABONNEMENTS -->
        <div class="faq-category active" id="abonnements">

            <div class="faq-category-title">
                Infos abonnements
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    À partir de quelle date peut-on acheter nos abonnements de saison?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>Les dates de mise en vente sont annoncées avant le début de la saison sur notre site web et nos réseaux sociaux.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Quels sont les tarifs d’abonnement pour la saison?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>Les tarifs sont disponibles dans la section Abonnements de notre site web.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Quels sont les avantages à acheter un abonnement Tout temps?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>L’abonnement Tout temps permet de profiter de la montagne selon les conditions et les périodes d’ouverture prévues.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Est-ce que je peux acheter mon abonnement en ligne?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>Oui, les abonnements peuvent être achetés en ligne lorsque la billetterie est ouverte.</p>
                </div>
            </div>

        </div>


        <!-- MONTAGNE ET PISTES -->
        <div class="faq-category" id="montagne">

            <div class="faq-category-title">
                Montagne et pistes
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Où puis-je consulter les conditions de neige?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>Les conditions de neige sont disponibles sur la page Conditions du site web.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Comment savoir quelles pistes sont ouvertes?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>La page Conditions indique les pistes ouvertes de jour et de soir selon les opérations.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Est-ce que les pistes sont éclairées le soir?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>Certaines pistes sont disponibles en soirée selon l’horaire et les conditions.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Est-ce que la pente-école est ouverte tous les jours?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>L’horaire de la pente-école peut varier. Consultez la page Conditions ou Horaires pour les détails.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Est-ce que la montagne ferme lors de mauvaise météo?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>La station peut ajuster ses opérations selon la météo, la sécurité et les conditions de glisse.</p>
                </div>
            </div>

        </div>


        <!-- HORAIRE ET NOUS JOINDRE -->
        <div class="faq-category" id="horaire">

            <div class="faq-category-title">
                Horaire et nous joindre
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Où puis-je consulter l’horaire de la station?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>L’horaire complet est disponible dans la section Horaires du site web.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Comment puis-je contacter la station?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>Vous pouvez nous joindre par téléphone, par courriel ou via la page Contact.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Où est située Vallée du Parc?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>La station est située à Shawinigan, au 10000 chemin de la Vallée-du-Parc.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Est-ce que les horaires changent pendant les Fêtes?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>Oui, un horaire spécial peut être en vigueur durant les Fêtes ou certaines périodes achalandées.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Où puis-je poser une question qui n’est pas dans la FAQ?
                    <span>+</span>
                </button>
                <div class="faq-answer">
                    <p>Vous pouvez utiliser la page Contact pour nous envoyer votre question.</p>
                </div>
            </div>

        </div>

    </div>

</section>


<script>
document.addEventListener("DOMContentLoaded", () => {

    const tabs = document.querySelectorAll(".faq-tab");
    const categories = document.querySelectorAll(".faq-category");
    const questions = document.querySelectorAll(".faq-question");

    tabs.forEach(tab => {
        tab.addEventListener("click", () => {
            const target = tab.dataset.target;

            tabs.forEach(item => item.classList.remove("active"));
            categories.forEach(category => category.classList.remove("active"));

            tab.classList.add("active");
            document.getElementById(target).classList.add("active");
        });
    });

    questions.forEach(question => {
        question.addEventListener("click", () => {
            const item = question.parentElement;

            item.classList.toggle("open");

            const icon = question.querySelector("span");
            icon.textContent = item.classList.contains("open") ? "−" : "+";
        });
    });

});
</script>