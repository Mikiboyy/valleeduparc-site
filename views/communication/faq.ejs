<!-- HERO -->
<section class="montagne-hero faq-hero">

    <div class="montagne-overlay"></div>

    <div class="montagne-content">

        <div class="montagne-text">

            <span class="montagne-subtitle">
                AIDE & INFORMATIONS
            </span>

            <h1>
                FOIRE AUX<br>
                QUESTIONS
            </h1>

            <p class="montagne-description">
                Trouvez rapidement les réponses aux questions fréquentes
                concernant les abonnements, la montagne, les pistes,
                les horaires et les moyens de nous joindre.
            </p>

            <div class="montagne-features">
                <div class="feature">✔ Infos abonnements</div>
                <div class="feature">✔ Montagne et pistes</div>
                <div class="feature">✔ Horaires</div>
                <div class="feature">✔ Nous joindre</div>
            </div>

        </div>

    </div>

</section>


<!-- FAQ -->
<section class="faq-section">

    <div class="faq-container">

        <div class="section-title">

            <span>FAQ</span>

            <h2>
                Questions fréquentes
            </h2>

        </div>


        <!-- =========================
             ONGLETS
        ========================== -->
        <div class="faq-tabs">

            <button
                type="button"
                class="faq-tab active"
                data-target="abonnements"
            >
                Infos abonnements
            </button>

            <button
                type="button"
                class="faq-tab"
                data-target="montagne"
            >
                Montagne et pistes
            </button>

            <button
                type="button"
                class="faq-tab"
                data-target="horaire"
            >
                Horaire et nous joindre
            </button>

            <button
                type="button"
                class="faq-tab"
                data-target="credit-maladie"
            >
                Demande de crédit - Maladie
            </button>

        </div>


        <!-- ========================================
             INFOS ABONNEMENTS
        ========================================= -->
        <div
            class="faq-category active"
            id="abonnements"
        >

            <div class="faq-category-title">
                Infos abonnements
            </div>


            <% if (
                groupedFaqs.abonnements &&
                groupedFaqs.abonnements.length > 0
            ) { %>

                <% groupedFaqs.abonnements.forEach(faq => { %>

                    <div class="faq-item">

                        <button
                            type="button"
                            class="faq-question"
                        >

                            <%= faq.question %>

                            <span>+</span>

                        </button>


                        <div class="faq-answer">

                            <p>
                                <%= faq.answer %>
                            </p>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <p>
                    Aucune question disponible.
                </p>

            <% } %>

        </div>


        <!-- ========================================
         MONTAGNE ET PISTES
         ========================================= -->
         
         <div class="faq-category" id="montagne">

            <div class="faq-category-title">
                Montagne et pistes
            </div>


            <!-- QUESTIONS MONTAGNE -->

            <% if (
                groupedFaqs.montagne &&
                groupedFaqs.montagne.length > 0
                ) { %>

                    <% groupedFaqs.montagne.forEach(faq => { %>

                        <div class="faq-item">

                            <button type="button" class="faq-question">

                                <%= faq.question %>

                                <span>+</span>

                            </button>


                            <div class="faq-answer">

                                <p>
                                    <%= faq.answer %>
                                </p>

                            </div>

                        </div>

                        <% }) %>

                        <% } %>


    <!-- QUESTIONS PISTES -->

    <% if (
        groupedFaqs.pistes &&
        groupedFaqs.pistes.length > 0
    ) { %>

        <% groupedFaqs.pistes.forEach(faq => { %>

            <div class="faq-item">

                <button
                    type="button"
                    class="faq-question"
                >

                    <%= faq.question %>

                    <span>+</span>

                </button>


                <div class="faq-answer">

                    <p>
                        <%= faq.answer %>
                    </p>

                </div>

            </div>

        <% }) %>

    <% } %>


    <% if (
        (!groupedFaqs.montagne ||
        groupedFaqs.montagne.length === 0)

        &&

        (!groupedFaqs.pistes ||
        groupedFaqs.pistes.length === 0)
    ) { %>

        <p>
            Aucune question disponible.
        </p>

    <% } %>

</div>

        <!-- ========================================
             HORAIRE ET NOUS JOINDRE
        ========================================= -->
        <div
            class="faq-category"
            id="horaire"
        >

            <div class="faq-category-title">
                Horaire et nous joindre
            </div>


            <!-- QUESTIONS HORAIRE -->

            <% if (
                groupedFaqs.horaire &&
                groupedFaqs.horaire.length > 0
            ) { %>

                <% groupedFaqs.horaire.forEach(faq => { %>

                    <div class="faq-item">

                        <button
                            type="button"
                            class="faq-question"
                        >

                            <%= faq.question %>

                            <span>+</span>

                        </button>


                        <div class="faq-answer">

                            <p>
                                <%= faq.answer %>
                            </p>

                        </div>

                    </div>

                <% }) %>

            <% } %>

        </div>

        <!-- ========================================
             DEMANDE DE CRÉDIT - MALADIE
        ========================================= -->
        <div class="faq-category" id="credit-maladie">

            <div class="faq-category-title">
                Demande de crédit - Maladie
            </div>


            <!-- INFORMATIONS -->
            <div class="credit-maladie-content">

                <h3>
                    Demande de crédit – Maladie
                </h3>

                <p>
                    Une personne peut demander un crédit sur son abonnement
                    si une raison médicale l'empêche de poursuivre sa saison.
                </p>

                <p>
                    Si la demande est reçue avant l'ouverture de la station,
                    aucune restriction s'applique et nous remboursons
                    l'abonnement.
                </p>

                <p>
                    L'abonné doit obligatoirement fournir un papier médical
                    attestant son incapacité à pratiquer un sport de glisse.
                </p>

                <p>
                    En remplissant le formulaire, le demandeur s'engage à
                    fournir les documents requis et accepte toutes les
                    conditions du présent programme de demande de crédit.
                </p>


                <!-- CONDITIONS -->
                <h4>
                    Conditions
                </h4>

                <ul>

                    <li>
                        Toute demande doit être déposée par le détenteur
                        de l'abonnement.
                    </li>

                    <li>
                        Seules les professionnelles de la santé suivantes sont
                        acceptées : médecin, physiothérapeute, ostéopathe
                        et chiropraticien.
                    </li>

                    <li>
                        L'acceptation ou le refus de la demande est à
                        l'entière discrétion de la direction.
                    </li>

                    <li>
                        Un délai raisonnable pour le traitement de la demande
                        est à prévoir, soit environ 15 jours ouvrables.
                    </li>

                    <li>
                        Le délai s'applique à partir de la réception des
                        informations et documents requis.
                    </li>

                    <li>
                        Le montant crédité est calculé selon l'utilisation
                        de l'abonnement.
                    </li>

                    <li>
                        Des frais administratifs de 35 $ s'appliquent.
                    </li>

                </ul>


                <!-- TABLEAU DES CRÉDITS -->
                <div class="credit-table-wrapper">

                    <table class="credit-table">

                        <thead>

                            <tr>

                                <th>
                                    Période
                                </th>

                                <th>
                                    Usages
                                </th>

                                <th>
                                    Crédit
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <!-- 1ER JANVIER -->
                            <tr>

                                <td rowspan="5">
                                    1er utilisation au 15 janvier
                                    de la saison en cours
                                </td>

                                <td>
                                    Aucun usage
                                </td>

                                <td>
                                    80 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    1 à 3 usages
                                </td>

                                <td>
                                    60 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    4 à 6 usages
                                </td>

                                <td>
                                    40 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    7 à 9 usages
                                </td>

                                <td>
                                    20 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    10 usages ou +
                                </td>

                                <td>
                                    Aucun crédit
                                </td>

                            </tr>


                            <!-- 16 JANVIER -->
                            <tr>

                                <td rowspan="5">
                                    16 janvier au 15 février
                                    de la saison en cours
                                </td>

                                <td>
                                    Aucun usage
                                </td>

                                <td>
                                    70 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    1 à 3 usages
                                </td>

                                <td>
                                    50 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    4 à 6 usages
                                </td>

                                <td>
                                    30 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    7 à 9 usages
                                </td>

                                <td>
                                    10 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    10 usages ou +
                                </td>

                                <td>
                                    Aucun crédit
                                </td>

                            </tr>


                            <!-- 16 FÉVRIER -->
                            <tr>

                                <td rowspan="5">
                                    16 février au 15 mars
                                    de la saison en cours
                                </td>

                                <td>
                                    Aucun usage
                                </td>

                                <td>
                                    40 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    1 à 3 usages
                                </td>

                                <td>
                                    30 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    4 à 6 usages
                                </td>

                                <td>
                                    10 %
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    7 à 9 usages
                                </td>

                                <td>
                                    Aucun crédit
                                </td>

                            </tr>

                            <tr>

                                <td>
                                    10 usages ou +
                                </td>

                                <td>
                                    Aucun crédit
                                </td>

                            </tr>


                            <!-- APRÈS LE 16 MARS -->
                            <tr>

                                <td>
                                    16 mars à la fin de la saison
                                </td>

                                <td colspan="2">
                                    Aucun crédit ne sera accordé
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- FORMULAIRE -->
                <div class="credit-form-container">

                    <h3>
                        Formulaire de demande de crédit / remboursement
                    </h3>

                    <% if (success) { %>

                        <div class="form-success">

                            <strong>✓ Votre demande a été envoyée avec succès.</strong>

                            <p>
                                Un courriel de confirmation vous a été envoyé.
                            </p>

                        </div>

                        <% } %>


                    <form
                        action="/demande-credit-maladie"
                        method="POST"
                        enctype="multipart/form-data"
                        class="credit-form"
                    >


                        <!-- NOM DU CLIENT PAYEUR -->
                        <div class="form-row">

                            <div class="form-group">

                                <label for="prenom-payeur">
                                    Prénom du client (payeur) *
                                </label>

                                <input
                                    type="text"
                                    id="prenom-payeur"
                                    name="prenomPayeur"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label for="nom-payeur">
                                    Nom du client (payeur) *
                                </label>

                                <input
                                    type="text"
                                    id="nom-payeur"
                                    name="nomPayeur"
                                    required
                                >

                            </div>

                        </div>


                        <!-- ADRESSE -->
                        <div class="form-group">

                            <label for="adresse">
                                Adresse complète *
                            </label>

                            <input
                                type="text"
                                id="adresse"
                                name="adresse"
                                required
                            >

                        </div>


                        <!-- TÉLÉPHONES -->
                        <div class="form-row form-row-three">


                            <div class="form-group">

                                <label for="telephone-principal">
                                    Téléphone (principal) *
                                </label>

                                <input
                                    type="tel"
                                    id="telephone-principal"
                                    name="telephonePrincipal"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label for="telephone-cellulaire">
                                    Téléphone (cellulaire)
                                </label>

                                <input
                                    type="tel"
                                    id="telephone-cellulaire"
                                    name="telephoneCellulaire"
                                >

                            </div>


                            <div class="form-group">

                                <label for="telephone-bureau">
                                    Téléphone (bureau)
                                </label>

                                <input
                                    type="tel"
                                    id="telephone-bureau"
                                    name="telephoneBureau"
                                >

                            </div>


                        </div>


                        <!-- COURRIEL -->
                        <div class="form-group">

                            <label for="courriel">
                                Courriel *
                            </label>

                            <input
                                type="email"
                                id="courriel"
                                name="courriel"
                                required
                            >

                        </div>


                        <!-- DÉTENTEUR DE L'ABONNEMENT -->
                        <div class="form-row">


                            <div class="form-group">

                                <label for="prenom-detenteur">
                                    Prénom
                                </label>

                                <small>
                                    du détenteur de l'abonnement
                                </small>

                                <input
                                    type="text"
                                    id="prenom-detenteur"
                                    name="prenomDetenteur"
                                >

                            </div>


                            <div class="form-group">

                                <label for="nom-detenteur">
                                    Nom
                                </label>

                                <small>
                                    du détenteur de l'abonnement
                                </small>

                                <input
                                    type="text"
                                    id="nom-detenteur"
                                    name="nomDetenteur"
                                >

                            </div>


                        </div>


                        <!-- NUMÉRO CLIENT -->
                        <div class="form-group">

                            <label for="numero-client">
                                Numéro de client ou numéro de facture
                            </label>

                            <small>
                                (Passez ce champ si inconnu)
                            </small>

                            <input
                                type="text"
                                id="numero-client"
                                name="numeroClient"
                            >

                        </div>


                        <!-- PRODUITS -->
                        <div class="form-group">

                            <label>
                                Cochez le ou les produits pour lesquels vous
                                souhaitez obtenir un dédommagement *
                            </label>

                            <small>
                                (Sélectionnez un produit ou plusieurs choix)
                            </small>


                            <div class="checkbox-group">

                                <label>

                                    <input
                                        type="checkbox"
                                        name="produits"
                                        value="Casier"
                                    >

                                    Casier

                                </label>


                                <label>

                                    <input
                                        type="checkbox"
                                        name="produits"
                                        value="Abonnement ski"
                                    >

                                    Abonnement ski

                                </label>


                                <label>

                                    <input
                                        type="checkbox"
                                        name="produits"
                                        value="Abonnement raquettes"
                                    >

                                    Abonnement raquettes

                                </label>


                                <label>

                                    <input
                                        type="checkbox"
                                        name="produits"
                                        value="Abonnement randonnée alpine"
                                    >

                                    Abonnement randonnée alpine

                                </label>

                            </div>

                        </div>


                        <!-- TYPE DE DEMANDE -->
                        <div class="form-group">

                            <label>
                                Vous souhaitez :
                            </label>


                            <div class="radio-group">

                                <label>

                                    <input
                                        type="radio"
                                        name="demande"
                                        value="credit"
                                        required
                                    >

                                    Obtenir un crédit applicable sur les
                                    produits de votre choix à la Billetterie
                                    ou à l'École de glisse selon la politique
                                    en vigueur.

                                </label>


                                <label>

                                    <input
                                        type="radio"
                                        name="demande"
                                        value="remboursement"
                                    >

                                    Obtenir un remboursement.

                                </label>

                            </div>


                            <small>
                                Les demandes de crédit et de remboursement sont
                                traitées selon les conditions du programme.
                            </small>

                        </div>


                        <!-- IMPORTANT -->
                        <div class="credit-important">

                            <h4>
                                Important :
                            </h4>

                            <ul>

                                <li>
                                    Veuillez noter qu'un délai de 3 semaines
                                    peut être nécessaire pour le traitement
                                    de votre demande.
                                </li>

                                <li>
                                    Pour un crédit, vous recevrez un courriel
                                    confirmant le montant applicable.
                                </li>

                                <li>
                                    Pour un remboursement, vous recevrez un
                                    chèque par la poste.
                                </li>

                            </ul>

                        </div>


                        <!-- PREUVE MÉDICALE -->
                        <div class="form-group">

                            <label for="preuve-medicale">
                                Veuillez joindre une preuve médicale *
                            </label>

                            <input
                                type="file"
                                id="preuve-medicale"
                                name="preuveMedicale"
                                accept=".pdf,.jpg,.jpeg,.png"
                                required
                            >

                        </div>


                        <!-- COMMENTAIRES -->
                        <div class="form-group">

                            <label for="commentaires">
                                Commentaires :
                            </label>

                            <textarea
                                id="commentaires"
                                name="commentaires"
                                rows="6"
                            ></textarea>

                        </div>


                        <!-- ENVOYER -->
                        <button
                            type="submit"
                            class="credit-submit-btn"
                        >

                            Envoyer

                        </button>


                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


<script>

document.addEventListener("DOMContentLoaded", () => {

    const tabs =
        document.querySelectorAll(".faq-tab");

    const categories =
        document.querySelectorAll(".faq-category");

    const questions =
        document.querySelectorAll(".faq-question");


    /* =========================
       CHANGEMENT D'ONGLET
    ========================= */

    tabs.forEach(tab => {

        tab.addEventListener("click", () => {

            const target =
                tab.dataset.target;


            tabs.forEach(item => {

                item.classList.remove("active");

            });


            categories.forEach(category => {

                category.classList.remove("active");

            });


            tab.classList.add("active");


            document
                .getElementById(target)
                .classList.add("active");

        });

    });


    /* =========================
       ACCORDÉON FAQ
    ========================= */

    questions.forEach(question => {

        question.addEventListener("click", () => {

            const item =
                question.parentElement;


            item.classList.toggle("open");


            const icon =
                question.querySelector("span");


            icon.textContent =
                item.classList.contains("open")
                    ? "−"
                    : "+";

        });

    });

});

</script>