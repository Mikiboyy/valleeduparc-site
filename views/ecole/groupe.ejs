const cardsContainer = document.getElementById("coursCards");
const modalsContainer = document.getElementById("coursModals");

cours.forEach(c => {
    cardsContainer.innerHTML += `
        <div class="ecole-card" onclick="openCoursModal('modal-${c.id}')">
            <div class="ecole-card-top">${c.titre}<br>${c.duree}</div>
