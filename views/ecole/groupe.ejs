<section class="montagne-hero groupe-hero">
    <div class="montagne-overlay"></div>

    <div class="montagne-content">
        <div class="montagne-text">
            <span class="montagne-subtitle">ÉCOLE DE GLISSE</span>

            <h1>COURS<br>DE GROUPE</h1>

            <p class="montagne-description">
                Apprenez à skier ou à faire de la planche à neige
                dans un environnement sécuritaire et dynamique.
                Nos programmes sont conçus pour tous les âges et
                tous les niveaux.
            </p>

            <div class="montagne-features">
                <div class="feature">✔ Moniteurs certifiés</div>
                <div class="feature">✔ Progression adaptée</div>
                <div class="feature">✔ Ambiance conviviale</div>
                <div class="feature">✔ Programmes pour tous les âges</div>
            </div>
        </div>

        <div class="ecole-hero-image">
            <img src="/image/groupe.webp" alt="Cours de groupe Vallée du Parc">
        </div>
    </div>
</section>

<section class="ecole-cards-section">

    <% if (adminUser && (adminUser.role === 'admin' || adminUser.role === 'prix')) { %>
        <a href="../admin/price-courses.ejs" class="btn-primary">
            Modifier les prix
        </a>
        <% } %>

    <div class="ecole-cards">

        <% if (courses && courses.length > 0) { %>

            <% courses.forEach(course => { %>

                <div class="ecole-card" onclick="openCoursModal('modal-<%= course._id %>')">
                    <div class="ecole-card-top">
                        <%= course.category %><br>
                        <%= course.title %>
                    </div>

                    <p><%= course.summary %></p>

                    <p class="course-price">

                        <% if (
                            preventeActive &&
                            course.prices?.presalePrice !== null &&
                            course.prices?.presalePrice !== undefined
                            ) { %>

                                <span class="prevente-label">
                                    PRÉ-VENTE
                                </span>

                                <span class="prevente-price">

                                    <% if (course.presalePriceLabel) { %>

                                        <%= course.presalePriceLabel %>

                                        <% } else { %>

                                            <%= course.prices?.presalePrice.toFixed(2) %> $

                                            <% } %>

                                        </span>


                                        <% if (
                                            course.prices?.regularPrice !== null &&
                                            course.prices?.regularPrice !== undefined
                                            ) { %>

                                                <span class="regular-price">

                                                    Prix régulier :
                                                    <%= course.prices?.regularPrice.toFixed(2) %> $

                                                </span>

                                                <% } %>


                                                <% } else { %>


                                                    <% if (course.priceLabel) { %>

                                                        <%= course.priceLabel %>

                                                        <% } else if (
                                                            course.prices?.regularPrice !== null &&
                                                            course.prices?.regularPrice !== undefined
                                                            ) { %>

                                                                <%= course.prices?.regularPrice.toFixed(2) %> $

                                                                <% } else { %>

                                                                    -

                                                                    <% } %>


                                                                    <% } %>

                                                                </p>
                </div>

            <% }) %>

        <% } else { %>

            <p>Aucun cours disponible pour le moment.</p>

        <% } %>

    </div>
</section>

<% courses.forEach(course => { %>

    <div id="modal-<%= course._id %>" class="cours-modal">
        <div class="cours-modal-content">

            <span class="close-modal" onclick="closeCoursModal('modal-<%= course._id %>')">
                &times;
            </span>

            <h2><%= course.title %></h2>

            <p><strong>Catégorie :</strong> <%= course.category %></p>
            <p><strong>Durée :</strong> <%= course.duration %></p>
            <p>
                <strong>Période :</strong>

                <%= preventeActive ? 'Pré-vente' : 'Prix régulier' %>
            </p>

            <p>

                <strong>Prix :</strong>


                <% if (
                    preventeActive &&
                    course.prices?.presalePrice !== null &&
                    course.prices?.presalePrice !== undefined
                    ) { %>

                        <span class="prevente-modal-price">

                            PRÉ-VENTE :

                            <% if (course.presalePriceLabel) { %>

                                <%= course.presalePriceLabel %>

                                <% } else { %>

                                    <%= course.prices?.presalePrice.toFixed(2) %> $

                                    <% } %>

                                </span>


                                <% } else { %>


                                    <% if (course.priceLabel) { %>

                                        <%= course.priceLabel %>

                                        <% } else if (
                                            course.prices?.regularPrice !== null &&
                                            course.prices?.regularPrice !== undefined
                                            ) { %>

                                                <%= course.prices?.regularPrice.toFixed(2) %> $

                                                <% } else { %>

                                                    -

                                                    <% } %>

                                                    <% } %>

                                                </p>

            <div>
                <%- course.details %>
            </div>

            <p>
                <strong>Conditions :</strong><br>
                Un abonnement saisonnier ou un billet valide peut être requis pour la durée du programme.
            </p>

            <a href="/inscription?returnUrl=/cours-groupe" class="btn-primary">
                S'INSCRIRE
            </a>

        </div>
    </div>

<% }) %>

<script>
function openCoursModal(id) {
    const modal = document.getElementById(id);

    if (modal) {
        modal.style.display = "flex";
    }
}

function closeCoursModal(id) {
    const modal = document.getElementById(id);

    if (modal) {
        modal.style.display = "none";
    }
}

window.addEventListener("click", function(event) {
    document.querySelectorAll(".cours-modal").forEach(function(modal) {
        if (event.target === modal) {
            modal.style.display = "none";
        }
    });
});
</script>