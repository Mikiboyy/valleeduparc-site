        </div>
    `;

    modalsContainer.innerHTML += `
        <div id="modal-${c.id}" class="cours-modal">
            <div class="cours-modal-content">
                <span class="close-modal" onclick="closeCoursModal('modal-${c.id}')">&times;</span>

