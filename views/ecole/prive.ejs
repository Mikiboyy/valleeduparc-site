<section class="montagne-hero prive-hero">

    <div class="montagne-overlay"></div>

    <div class="montagne-content">

        <div class="montagne-text">

            <span class="montagne-subtitle">ÉCOLE DE GLISSE</span>

            <h1>
                COURS<br>
                PRIVÉS
            </h1>

            <p class="montagne-description">
                Profitez d’un accompagnement personnalisé avec nos moniteurs.
                En privé, semi-privé ou en bloc de leçons, progressez à votre rythme
                dans un environnement sécuritaire.
            </p>

            <div class="montagne-features">
                <div class="feature">✔ Cours personnalisés</div>
                <div class="feature">✔ Ski ou planche à neige</div>
                <div class="feature">✔ Privé ou semi-privé</div>
                <div class="feature">✔ Moniteurs qualifiés</div>
            </div>

        </div>

        <div class="ecole-hero-image">
            <img src="/image/cours.webp" alt="Cours privés Vallée du Parc">
        </div>

    </div>

</section>

<section class="ecole-cards-section">

    <% if (adminUser && (adminUser.role === 'admin' || adminUser.role === 'prix')) { %>
        <a href="/cours-prive" class="btn-primary">
            Modifier les prix
        </a>
        <% } %>

    <div class="ecole-cards">

        <% if (courses && courses.length > 0) { %>

            <% courses.forEach(course => { %>

                <div class="ecole-card" onclick="openPriveModal('modal-<%= course._id %>')">
                    <div class="ecole-card-top">
                        <%= course.category %><br>
                        <%= course.title %>
                    </div>

                    <p><%= course.summary %></p>

                    <p class="course-price">

                        <% if (
                            preventeActive &&
                            course.prices?.presalePrice !== null &&
                            course.prices?.presalePrice !== undefined
                            ) { %>

                                <span class="prevente-label">
                                    PRÉ-VENTE
                                </span>

                                <span class="prevente-price">

                                    <% if (course.presalePriceLabel) { %>

                                        <%= course.presalePriceLabel %>

                                        <% } else { %>

                                            <%= course.prices.presalePrice.toFixed(2) %> $

                                            <% } %>

                                        </span>


                                        <% if (
                                            course.prices?.regularPrice !== null &&
                                            course.prices?.regularPrice !== undefined
                                            ) { %>

                                                <span class="regular-price">

                                                    Prix régulier :
                                                    <%= course.prices.regularPrice.toFixed(2) %> $

                                                </span>

                                                <% } %>


                                                <% } else { %>


                                                    <% if (course.priceLabel) { %>

                                                        <%= course.priceLabel %>

                                                        <% } else if (
                                                            course.prices?.regularPrice !== null &&
                                                            course.prices?.regularPrice !== undefined
                                                            ) { %>

                                                                <%= course.prices.regularPrice.toFixed(2) %> $

                                                                <% } else { %>

                                                                    -

                                                                    <% } %>


                                                                    <% } %>

                                                                </p>
                </div>

            <% }) %>

        <% } else { %>

            <p>Aucun cours privé disponible pour le moment.</p>

        <% } %>

    </div>
</section>

<% courses.forEach(course => { %>

    <div id="modal-<%= course._id %>" class="cours-modal">
        <div class="cours-modal-content">

            <span class="close-modal" onclick="closePriveModal('modal-<%= course._id %>')">
                &times;
            </span>

            <h2><%= course.title %></h2>

            <p><strong>Catégorie :</strong> <%= course.category %></p>
            <p><strong>Durée :</strong> <%= course.duration %></p>
            <p>
                <strong>Période :</strong>

                <%= preventeActive ? 'Pré-vente' : 'Prix régulier' %>
            </p>

            <p>

                <strong>Prix :</strong>

                <% if (
                    preventeActive &&
                    course.prices?.presalePrice !== null &&
                    course.prices?.presalePrice !== undefined
                    ) { %>

                        <span class="prevente-modal-price">

                            PRÉ-VENTE :

                            <% if (course.presalePriceLabel) { %>

                                <%= course.presalePriceLabel %>

                                <% } else { %>

                                    <%= course.prices.presalePrice.toFixed(2) %> $

                                    <% } %>

                                </span>

                                <% } else { %>

                                    <% if (course.priceLabel) { %>

                                        <%= course.priceLabel %>

                                        <% } else if (
                                            course.prices?.regularPrice !== null &&
                                            course.prices?.regularPrice !== undefined
                                            ) { %>

                                                <%= course.prices.regularPrice.toFixed(2) %> $

                                                <% } else { %>

                                                    -

                                                    <% } %>

                                                    <% } %>

                                                </p>
            <div>
                <%- course.details %>
            </div>

            <p>
                <strong>Restrictions :</strong><br>
                En cas de température incertaine, la station se réserve le droit de vérifier si la situation permet la tenue du cours.
            </p>

            <a
            href="/inscription/prive?courseId=<%= course._id %>&returnUrl=/cours-prive"
            class="btn-primary">
            S'INSCRIRE
        </a>

        </div>
    </div>

<% }) %>

<script>
function openPriveModal(id) {
    const modal = document.getElementById(id);

    if (modal) {
        modal.style.display = "flex";
    }
}

function closePriveModal(id) {
    const modal = document.getElementById(id);

    if (modal) {
        modal.style.display = "none";
    }
}

window.addEventListener("click", function(event) {
    document.querySelectorAll(".cours-modal").forEach(function(modal) {
        if (event.target === modal) {
            modal.style.display = "none";
        }
    });
});
</script>