<!-- ACTUALITÉS -->
<section class="home-events-section">

    <div class="section-title home-events-title">
        <span>ACTUALITÉS</span>
        <h2>Actualités & Événements</h2>
    </div>

    <div class="home-events-grid">

        <% if (events && events.length > 0) { %>

            <% events.forEach(event => { %>

                <a href="/evenements" class="home-event-card-link">

                    <article class="home-event-card">

                        <img
                        src="<%= event.image || '/uploads/default.jpg' %>"
                        alt="<%= event.title %>"
                        class="home-event-image"
                        loading="lazy"
                        decoding="async"
                        >

                        <div class="home-event-content">

                            <span class="event-date">
                                <% if (event.date && !isNaN(new Date(event.date).getTime())) { %>
                                    <%= new Date(event.date).toLocaleDateString('fr-CA') %>
                                    <% } else { %>
                                        Date à venir
                                        <% } %>
                            </span>

                            <h3><%= event.title %></h3>

                            <p>
                                <%= event.description || '' %>
                            </p>

                            <span class="event-link">
                                En savoir plus →
                            </span>

                        </div>

                    </article>

                </a>

            <% }) %>

        <% } else { %>

            <p class="no-home-events">
                Aucun événement disponible pour le moment.
            </p>

        <% } %>

    </div>

    <% if (typeof totalEvents !== 'undefined' && totalEvents > 3) { %>
        <div class="home-events-more">
            <a href="/evenements" class="btn-primary">
                Voir tous les événements
            </a>
        </div>
    <% } %>

</section>


<!-- COMMANDITAIRES -->
<section class="partners-section">

    <h2>Nos partenaires</h2>

    <div class="partners-slider">

        <button class="partner-arrow left" onclick="movePartners(-1)">
            &#10094;
        </button>

        <div class="partners-container">

            <div class="partners-track" id="partnersTrack">

                <div class="partner-item">
                    <a href="https://brunelleskivelo.com/" target="_blank">
                        <img src="/image/partners/brunelle.png" alt="Brunelle Ski Vélo" loading="lazy">
                    </a>
                </div>

                <div class="partner-item">
                    <a href="https://s3boardshop.com/" target="_blank">
                        <img src="/image/partners/s3.png" alt="S3 Boardshop" loading="lazy">
                    </a>
                </div>

                <div class="partner-item">
                    <a href="https://www.cegepshawinigan.ca/" target="_blank">
                        <img src="/image/partners/cegepShawi.png" alt="Cégep Shawinigan" loading="lazy">
                    </a>
                </div>

                <div class="partner-item">
                    <a href="https://www.head.com/en_CA/" target="_blank">
                        <img src="/image/partners/head.png" alt="Head" loading="lazy">
                    </a>
                </div>

                <div class="partner-item">
                    <a href="https://www.mvmmotosport.com/fr/" target="_blank">
                        <img src="/image/partners/mvm.png" alt="MVM">
                    </a>
                </div>

                <div class="partner-item">
                    <a href="https://vpservicesalimentaires.com/" target="_blank">
                        <img src="/image/partners/vp.png" alt="VP Services" loading="lazy">
                    </a>
                </div>

                <div class="partner-item">
                    <a href="https://www.sportsexperts.ca/fr-CA/" target="_blank">
                        <img src="/image/partners/sportexperts.png" alt="Sports Experts" loading="lazy">
                    </a>
                </div>

                <div class="partner-item">
                    <a href="https://alignementmauricie.com/" target="_blank">
                        <img src="/image/partners/alignementMauricie.png" alt="Alignement Mauricie" loading="lazy">
                    </a>
                </div>

                <div class="partner-item">
                    <a href="https://fromagerievictoria.com/" target="_blank">
                        <img src="/image/partners/fromagerieVictoria.png" alt="Fromagerie Victoria" loading="lazy">
                    </a>
                </div>

            </div>

        </div>

        <button class="partner-arrow right" onclick="movePartners(1)">
            &#10095;
        </button>

    </div>

</section>


<script>
document.addEventListener("DOMContentLoaded", function () {

    const track = document.getElementById("partnersTrack");

    if (!track) return;

    let items = document.querySelectorAll(".partner-item");
    let currentPartner = 0;

    function getVisibleItems() {
        return window.innerWidth <= 768 ? 2 : 5;
    }

    let visibleItems = getVisibleItems();

    for (let i = 0; i < visibleItems; i++) {
        const clone = items[i].cloneNode(true);
        track.appendChild(clone);
    }

    items = document.querySelectorAll(".partner-item");

    window.movePartners = function(direction) {
        const itemWidth = items[0].offsetWidth;

        currentPartner += direction;

        track.style.transition = "transform 0.5s ease";
        track.style.transform =
            `translateX(-${currentPartner * itemWidth}px)`;

        if (currentPartner >= items.length - visibleItems) {
            setTimeout(() => {
                track.style.transition = "none";
                currentPartner = 0;
                track.style.transform = "translateX(0px)";
            }, 500);
        }

        if (currentPartner < 0) {
            currentPartner = items.length - visibleItems - 1;
            track.style.transition = "none";
            track.style.transform =
                `translateX(-${currentPartner * itemWidth}px)`;
        }
    };

    setInterval(() => {
        movePartners(1);
    }, 5000);

});
</script>