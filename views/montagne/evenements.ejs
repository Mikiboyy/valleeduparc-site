<section class="events-page">

    <div class="events-header">
        <span>CALENDRIER</span>
        <h1>Événements</h1>
        <p>Consultez les activités à venir et revoyez les événements passés de Vallée du Parc.</p>
    </div>

    <script id="calendarEventsData" type="application/json">
        <%- JSON.stringify(allEvents || []) %>
    </script>

    <!-- CALENDRIER ÉVÉNEMENTS À VENIR -->
    <section class="events-calendar-section">

        <div class="calendar-top">
            <button id="prevMonth" type="button">‹</button>
            <h2 id="calendarTitle"></h2>
            <button id="nextMonth" type="button">›</button>
        </div>

        <div class="calendar-grid calendar-days">
            <div>Dim</div>
            <div>Lun</div>
            <div>Mar</div>
            <div>Mer</div>
            <div>Jeu</div>
            <div>Ven</div>
            <div>Sam</div>
        </div>

        <div class="calendar-grid" id="calendarGrid"></div>

    </section>

    <% if (adminUser && (adminUser.role === 'admin' || adminUser.role === 'evenement')) { %>
            <a href="/admin-vdp/events" class="btn-primary">
                Modifier les événements
            </a>
            <% } %>

    <!-- ÉVÉNEMENTS PASSÉS -->
    <section class="past-events-section">

        <div class="section-title">
            <span>ARCHIVES</span>
            <h2>Tous les événements</h2>
        </div>

        <div class="events-grid past">

            <% if (allEvents && allEvents.length > 0) { %>

                <% allEvents.forEach(event => { %>

                    <div class="event-card"
                         data-title="<%= event.title %>"
                         data-date="<%= event.dates && event.dates.length > 0 ? event.dates.map(date => new Date(date).toLocaleDateString('fr-CA') ).join(', ') : '' %>"
                         data-description="<%= event.description || '' %>"
                         data-image="<%= event.image || '/uploads/default.jpg' %>">

                        <div class="event-image">
                            <img 
                            src="<%= event.image || '/uploads/default.jpg' %>" 
                            alt="<%= event.title %>"
                            >
                        </div>

                        <div class="event-content">

                            <span class="date">
                                <% if (event.dates && event.dates.length > 0) { %>

                                    <% event.dates.forEach((date, index) => { %>

                                        <%= new Date(date).toLocaleDateString(
                                            'fr-CA',
                                            {
                                                year: 'numeric',
                                                month: 'long',
                                                day: 'numeric'
                                            }
                                            ) %>

                                            <% if (index < event.dates.length - 1) { %>
                                                <br>
                                                <% } %>

                                                <% }) %>

                                                <% } %>
                            </span>

                            <h3><%= event.title %></h3>

                            <p>
                                <%= event.description ? event.description.substring(0, 100) : '' %>...
                            </p>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <p class="no-event">Aucune activité passée.</p>

            <% } %>

        </div>

    </section>

    <!-- MODAL -->
    <div id="eventModal" class="event-modal">

        <div class="event-modal-content">

            <span class="close-modal">&times;</span>

            <img id="modalImage" src="" alt="">

            <h2 id="modalTitle"></h2>

            <p id="modalDate"></p>

            <p id="modalDescription"></p>

        </div>

    </div>

</section>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const calendarEvents = JSON.parse(
        document.getElementById("calendarEventsData").textContent || "[]"
    );

    let currentDate = new Date();

    const calendarGrid = document.getElementById("calendarGrid");
    const calendarTitle = document.getElementById("calendarTitle");
    const modal = document.getElementById("eventModal");
    const closeModalBtn = document.querySelector(".close-modal");


    /* =========================================
       FORMATER UNE DATE POUR LE CALENDRIER
    ========================================= */

    function formatDateKey(date) {

        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");

        return `${year}-${month}-${day}`;
    }


    /* =========================================
       CONVERSION DATE ÉVÉNEMENT
    ========================================= */

    function getEventDates(event) {

    if (!event.dates) {
        return [];
    }

    const dates = Array.isArray(event.dates)
        ? event.dates
        : [event.dates];

    return dates
        .filter(date => date)
        .map(date => {

            const eventDate = new Date(date);

            return new Date(
                eventDate.getUTCFullYear(),
                eventDate.getUTCMonth(),
                eventDate.getUTCDate()
            );

        })
        .filter(date => !isNaN(date.getTime()));

}


    /* =========================================
       FORMAT DATE AFFICHAGE
    ========================================= */

    function formatEventDate(date) {

    return date.toLocaleDateString(
        "fr-CA",
        {
            year: "numeric",
            month: "long",
            day: "numeric"
        }
    );

}


    /* =========================================
       PROTECTION HTML
    ========================================= */

    function escapeHtml(text) {

        return String(text || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }


    /* =========================================
       OUVRIR MODAL
    ========================================= */

    function openEventModal(item) {

        document.getElementById("modalTitle").textContent =
            item.dataset.title || "";

        document.getElementById("modalDate").textContent =
            item.dataset.date || "";

        document.getElementById("modalDescription").textContent =
            item.dataset.description || "";

        document.getElementById("modalImage").src =
            item.dataset.image || "/uploads/default.jpg";

        modal.style.display = "flex";
    }


    /* =========================================
       ACTIVER LES CLICS
    ========================================= */

    function activateEventClicks() {

        document
            .querySelectorAll(".event-card, .calendar-event")
            .forEach(item => {

                item.onclick = () => {

                    openEventModal(item);

                };

            });

    }


    /* =========================================
       AFFICHER LE CALENDRIER
    ========================================= */

    function renderCalendar() {

        calendarGrid.innerHTML = "";

        const year = currentDate.getFullYear();
        const month = currentDate.getMonth();


        /* TITRE DU MOIS */

        const monthName =
            currentDate.toLocaleDateString("fr-CA", {

                month: "long",
                year: "numeric"

            });

        calendarTitle.textContent =
            monthName.charAt(0).toUpperCase() +
            monthName.slice(1);


        /* PREMIER ET DERNIER JOUR */

        const firstDay =
            new Date(year, month, 1);

        const lastDay =
            new Date(year, month + 1, 0);

        const startDay =
            firstDay.getDay();

        const totalDays =
            lastDay.getDate();


        /* =========================================
           ORGANISER LES ÉVÉNEMENTS PAR DATE
        ========================================= */

        const eventsByDate = {};


        calendarEvents.forEach(event => {

    const eventDates =
        getEventDates(event);


    eventDates.forEach(eventDate => {

        const key =
            formatDateKey(eventDate);


        if (!eventsByDate[key]) {

            eventsByDate[key] = [];

        }


        eventsByDate[key].push({

            ...event,

            calendarDate:
                eventDate

        });

    });

});


        /* =========================================
           CASES VIDES AVANT LE PREMIER JOUR
        ========================================= */

        for (
            let i = 0;
            i < startDay;
            i++
        ) {

            calendarGrid.innerHTML +=
                `<div class="calendar-cell empty"></div>`;

        }


        /* =========================================
           GÉNÉRER LES JOURS DU MOIS
        ========================================= */

        for (
            let day = 1;
            day <= totalDays;
            day++
        ) {

            const date =
                new Date(year, month, day);

            const key =
                formatDateKey(date);

            const dayEvents =
                eventsByDate[key] || [];


            let eventsHTML = "";


            /* ÉVÉNEMENTS DE LA JOURNÉE */

            dayEvents.forEach(event => {

                const eventDate =
                    formatEventDate(
                        event.calendarDate
                    );

                const eventTitle =
                    escapeHtml(
                        event.title || "Événement"
                    );

                const eventDescription =
                    escapeHtml(
                        event.description || ""
                    );

                const eventImage =
                    escapeHtml(
                        event.image || "/uploads/default.jpg"
                    );


                eventsHTML += `

                    <button
                        class="calendar-event"
                        type="button"

                        data-title="${eventTitle}"

                        data-date="${eventDate}"

                        data-description="${eventDescription}"

                        data-image="${eventImage}">

                        ${eventTitle}

                    </button>

                `;

            });


            /* AJOUTER LA CASE */

            calendarGrid.innerHTML += `

                <div class="calendar-cell
                    ${dayEvents.length > 0 ? "has-event" : ""}">

                    <div class="calendar-day-number">
                        ${day}
                    </div>

                    ${eventsHTML}

                </div>

            `;

        }


        /* RÉACTIVER LES CLICS */

        activateEventClicks();

    }


    /* =========================================
       MOIS PRÉCÉDENT
    ========================================= */

    document
        .getElementById("prevMonth")
        .addEventListener("click", () => {

            currentDate.setMonth(
                currentDate.getMonth() - 1
            );

            renderCalendar();

        });


    /* =========================================
       MOIS SUIVANT
    ========================================= */

    document
        .getElementById("nextMonth")
        .addEventListener("click", () => {

            currentDate.setMonth(
                currentDate.getMonth() + 1
            );

            renderCalendar();

        });


    /* =========================================
       FERMER LE MODAL
    ========================================= */

    closeModalBtn.addEventListener("click", () => {

        modal.style.display = "none";

    });


    /* FERMER EN CLIQUANT À L'EXTÉRIEUR */

    window.addEventListener("click", event => {

        if (event.target === modal) {

            modal.style.display = "none";

        }

    });


    /* =========================================
       PREMIER AFFICHAGE
    ========================================= */

    renderCalendar();

});
</script>