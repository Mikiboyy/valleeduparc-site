                        <div>Samedi</div><div>Fermé</div>
                    </div>
                </div>
            </div>

            <div class="schedule-item">
                <div class="schedule-title">
                    <span>Horaire pour la semaine de relâche 2026</span>
                    <span class="toggle">+</span>
                </div>

                <div class="schedule-content">
                    <p>Du 28 février au 6 mars 2027</p>

                    <div class="schedule-table">
                        <div>Dimanche</div>
                        <div>Fermé</div>

                        <div>Lundi</div>
                        <div>Fermé</div>

                        <div>Mardi</div>
                        <div>Fermé</div>

                        <div>Mercredi</div>
                        <div>Fermé</div>

                        <div>Jeudi</div>
                        <div>Fermé</div>
                        
