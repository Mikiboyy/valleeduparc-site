<footer class="footer">

    <div class="footer-container">

        <!-- LOGO -->
        <div>
            <img src="/image/logo_VDP_blanc_final-12.png" alt="VDP">
        </div>

        <!-- CONTACT -->
        <div class="footer-contact">
            <h3>Contact</h3>

            <a href="https://maps.app.goo.gl/oZZRx7jPq2PEhfC5A" class="footer-link footer-address" target="_blank">
                10000, ch de la Vallée-du-parc<br>
                Shawinigan, QC<br>
                G9T 0N1
            </a>

            <p>
                <a href="tel:8195381639" class="footer-link">
                    819-538-1639
                </a>
            </p>

            <p>
                <a href="mailto:info@valleeduparc.com" class="footer-link">
                    info@valleeduparc.com
                </a>
            </p>

            <div class="footer-extra-links">
                <a href="/contact" class="footer-link">
                    Nous joindre
                </a>

                <a href="/documents/politique-confidentialite.pdf" class="footer-link" target="_blank">
                    Politique de confidentialité
                </a>
            </div>
        </div>

        <!-- NEWSLETTER -->
        <div class="footer-newsletter">
            <h3>RESTER INFORMÉ</h3>

            <p class="newsletter-text">
                Recevez nos nouveautés, promotions et conditions par courriel.
            </p>

            <form action="/subscribe" method="POST">

                <input 
                    type="text" 
                    name="firstName"
                    placeholder="Votre nom"
                    required
                >

                <input 
                    type="email" 
                    name="email"
                    placeholder="Votre email"
                    required
                >

                <button type="submit">
                    S'inscrire
                </button>

            </form>

            <% if (typeof success !== 'undefined' && success) { %>
                <p class="success-msg">
                    Merci pour votre inscription !
                </p>
            <% } %>

            <% if (typeof exists !== 'undefined' && exists) { %>
                <p class="error-msg">
                    Cet email est déjà inscrit.
                </p>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <p class="error-msg">
                    Une erreur est survenue.
                </p>
            <% } %>

        </div>

    </div>

    <!-- TRADUCTION -->
<div class="language-switcher">
    <div class="gtranslate_wrapper"></div>
</div>

</footer>