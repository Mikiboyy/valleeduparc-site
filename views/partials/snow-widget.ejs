<% if (typeof conditions !== 'undefined' && conditions) { %>
    
<div class="snow-float-btn" onclick="openSnowModal()">
    ❄️ Conditions de neige
</div>

<div id="conditionsModal" class="modal">

    <div class="modal-content">

        <span class="close-btn" onclick="closeSnowModal()">&times;</span>

        <h2 class="modal-title">Conditions de la station</h2>

        <div class="conditions-grid">

            <!-- PISTES -->
            <div class="condition-card">
                <strong>⛷️ Pistes jour</strong>
                <p><%= conditions.pistesJour %></p>
            </div>

            <div class="condition-card">
                <strong>🌙 Pistes nuit</strong>
                <p><%= conditions.pistesNuit %></p>
            </div>

            <!-- NEIGE -->
            <div class="condition-card">
                <strong>❄️ Neige 24h</strong>
                <p><%= conditions.neige24h %></p>
            </div>

            <div class="condition-card">
                <strong>❄️ Neige 48h</strong>
                <p><%= conditions.neige48h %></p>
            </div>

            <div class="condition-card">
                <strong>❄️ Neige 7 jours</strong>
                <p><%= conditions.neige7j %></p>
            </div>

            <div class="condition-card">
                <strong>❄️ Neige saison</strong>
                <p><%= conditions.neigeSaison %></p>
            </div>

            <!-- REMONTÉES -->
            <div class="condition-card">
                <strong>🚡 Télésièges jour</strong>
                <p><%= conditions.telesiegesJour %></p>
            </div>

            <div class="condition-card">
                <strong>🌙 Télésièges nuit</strong>
                <p><%= conditions.telesiegesNuit %></p>
            </div>

            <!-- ZONES -->
            <div class="condition-card">
                <strong>🌲 Sous-bois</strong>
                <p><%= conditions.sousBois %></p>
            </div>

            <div class="condition-card">
                <strong>🏂 Parc à neige</strong>
                <p><%= conditions.parcNeige %></p>
            </div>

            <div class="condition-card">
                <strong>⛰️ Randonnée alpine</strong>
                <p><%= conditions.randonnee %></p>
            </div>

            <a href="/conditions" class="condition-card condition-card-link">
                <strong>Conditions des pistes</strong>
                <p>Cliquer ici</p>
            </a>

            <!-- STATUT -->
            <div class="condition-card full">
                <strong>📍 Statut de la station</strong>
                <p><%= conditions.statut %></p>
            </div>

        </div>

    </div>

</div>

<script>
function openSnowModal() {
    document.getElementById("conditionsModal").style.display = "flex";
}

function closeSnowModal() {
    document.getElementById("conditionsModal").style.display = "none";
}

window.onclick = function(event) {
    const modal = document.getElementById("conditionsModal");
    if (event.target === modal) {
        modal.style.display = "none";
    }
}
</script>

<% } %>