<!-- HERO -->
<section class="montagne-hero location-hero">

    <div class="montagne-overlay"></div>

    <div class="montagne-content">

        <div class="montagne-text">

            <span class="montagne-subtitle">
                LOCATION D’ÉQUIPEMENT
            </span>

            <h1>
                LOUEZ VOTRE<br>
                ÉQUIPEMENT
            </h1>

            <p class="montagne-description">
                Vallée du Parc vous offre un service de location complet
                pour profiter pleinement de votre journée en ski ou en planche à neige.
            </p>

            <div class="montagne-features">
                <div class="feature">✔ Ski, bottes, bâtons et casque</div>
                <div class="feature">✔ Planche à neige et bottes</div>
                <div class="feature">✔ Location saisonnière disponible</div>
                <div class="feature">✔ Réservation recommandée</div>
            </div>

            <div class="montagne-buttons">
                <a href="/location-form?returnUrl=/location" class="btn-primary">
                    REMPLIR LE FORMULAIRE
                </a>

                <a href="#tarifs-location" class="btn-secondary">
                    VOIR LES TARIFS
                </a>
            </div>

        </div>

        <div class="location-hero-image">
            <img src="/image/location.webp" alt="Location Vallée du Parc">
        </div>

    </div>

</section>


<!-- INTRO -->
<section class="location-intro">

    <div class="location-container">

        <span class="section-subtitle">
            TARIFICATION
        </span>

        <h2>
            Location d’équipement
        </h2>

        <p>
            Consultez nos options de location saisonnière, complète ou individuelle.
            Pour faire une réservation à l’avance, veuillez remplir le formulaire au minimum
            <strong>24 heures avant</strong> le jour de la demande.
        </p>

        <p class="important-note">
            Location non-remboursable.
        </p>

    </div>

</section>


<%
    const items = typeof rentalItems !== 'undefined' ? rentalItems : [];

    function getItem(category, subCategory, name, ageGroup, period) {
        return items.find(item =>
            item.category === category &&
            item.subCategory === subCategory &&
            item.name === name &&
            item.ageGroup === ageGroup &&
            item.period === period
        );
    }

    function getPrice(category, subCategory, name, ageGroup, period) {
        const item = getItem(category, subCategory, name, ageGroup, period);

        if (!item) {
            return '';
        }

        return item.price.toFixed(0) + '$';
    }

    function getSimplePrice(category, name, ageGroup) {
        const item = items.find(item =>
            item.category === category &&
            item.name === name &&
            item.ageGroup === ageGroup
        );

        if (!item) {
            return '';
        }

        return item.price.toFixed(0) + '$';
    }
%>


