<section class="pricing-section" id="abonnements">

    <h2>Abonnements 2026-2027</h2>

    <% if (adminUser && (adminUser.role === 'admin' || adminUser.role === 'prix')) { %>
        <a href="/admin-vdp/prices" class="btn-primary">
            Modifier les prix
        </a>
    <% } %>


    <div class="pricing-wrapper">

        <% if (groupedPrices && groupedPrices.length > 0) { %>

            <% groupedPrices.forEach(group => { %>

                <% if (group.items && group.items.length > 0) { %>

                    <div class="pricing-group">

                        <!-- TITRE DE LA CATÉGORIE -->
                        <button class="pricing-toggle">
                            <span><%= group.category %></span>
                            <span class="icon">+</span>
                        </button>


                        <div class="pricing-content">

                            <!-- ==========================================
                                 DESCRIPTION SELON LE TYPE D'ABONNEMENT
                            =========================================== -->

                            <%
                                const category = group.category
                                    .toLowerCase()
                                    .normalize("NFD")
                                    .replace(/[\u0300-\u036f]/g, "");
                            %>


                            <!-- ==========================================
                                 PRESQUE TOUT-TEMPS
                            =========================================== -->

                            <% if (category.includes("presque")) { %>

                                <div class="subscription-info">

                                    <h3>
                                        Abonnement <em>Presque tout-temps</em>
                                    </h3>

                                    <p>
                                        L’abonnement
                                        <strong>Presque tout-temps</strong>
                                        est un abonnement de saison individuel.
                                    </p>

                                    <p>
                                        <strong>
                                            Valide 5 jours et 4 soirs dès le début de la saison :
                                        </strong>
                                    </p>

                                    <ul>
                                        <li>
                                            <strong>Lundi et mardi :</strong>
                                            9h00 à 16h00
                                        </li>

                                        <li>
                                            <strong>Mercredi au vendredi :</strong>
                                            9h00 à 21h30
                                        </li>

                                        <li>
                                            <strong>Samedi :</strong>
                                            16h00 à 21h30
                                        </li>
                                    </ul>

                                    <p>
                                        L’abonnement
                                        <strong>Presque tout-temps</strong>
                                        sera valide de
                                        <strong>9h00 à 21h30</strong>
                                        durant la période de Noël et de la semaine de relâche.
                                    </p>

                                    <p>
                                        <strong>Périodes :</strong>
                                        du 23 décembre au 5 janvier 2026
                                        et du 28 février au 6 mars 2027.
                                    </p>

                                    <p>
                                        <strong>Exception :</strong>
                                        le samedi et le dimanche,
                                        de 9h00 à 16h00.
                                    </p>

                                </div>


                            <!-- ==========================================
                             TOUT TEMPS
                             ========================================== -->

                             <% } else if (

                             category.includes("tout temps") ||

                             category.includes("tout-temps")
                             ) { %>

                                <div class="subscription-info">


                                    <h3>
                                        Abonnement <em>Tout temps</em>
                                    </h3>


                                    <!-- CONDITIONS -->

                                    <h4>CONDITIONS</h4>

                                    <p>
                                        L’abonnement <strong>Tout temps</strong> est valide :
                                        du mercredi au samedi de 9h à 21h30 et les dimanches,
                                        lundis et mardis de 9h à 16h.
                                    </p>

                                    <p>
                                        Veuillez prendre note que la station fermera à 15h les
                                        24 et 31 décembre 2026 et qu'elle sera fermée le
                                        25 décembre 2026 ainsi que le 1er janvier 2027.
                                    </p>


                                    <!-- AVANTAGES MEMBRES -->

                                    <h4>AVANTAGES MEMBRES TOUT TEMPS</h4>

                                    <p>
                                        Accès gratuit au siège dans le cadre du Festival des Couleurs.
                                    </p>

                                    <p>
                                        Invitation VIP au 5 à 7 organisé par Vallée du Parc.
                                    </p>


                                    <!-- BOUTIQUE -->

                                    <h4>BOUTIQUE - VALLÉE DU PARC</h4>

                                    <p>
                                        15 % de rabais à prix régulier.
                                    </p>

                                    <p>
                                        *En tout temps (ne peut être combiné à aucune autre offre).
                                    </p>


                                    <!-- MONTAGNE -->

                                    <h4>MONTAGNE</h4>

                                    <p>
                                        Accès gratuit aux sentiers de randonnée alpine
                                        (valeur de 250 $ + tx) sur présentation de votre passe.
                                    </p>


                                    <!-- ÉCOLE DE GLISSE -->

                                    <h4>ÉCOLE DE GLISSE</h4>

                                    <p>
                                        20 % de rabais sur un cours privé avec un moniteur de
                                        l'École de glisse de Vallée du Parc.
                                        Valide selon la disponibilité, pour une leçon d'une durée
                                        de 1 heure.
                                    </p>

                                    <p>
                                        Sur réservation et présentation de votre passe de saison
                                        uniquement (non transférable).
                                        Ne peut être combiné à aucune autre offre.
                                    </p>


                                    <!-- BILLETTERIE -->

                                    <h4>BILLETTERIE</h4>

                                    <p>
                                        15 % de rabais sur la luge, de jour ou de soir,
                                        sur présentation de votre passe Tout Temps.
                                    </p>

                                    <p>
                                        Sur réservation, selon l'horaire disponible
                                        (ne peut être combiné à aucune autre offre).
                                    </p>


                                    <!-- SKIEZ ET SURFEZ -->

                                    <h4>SKIEZ AILLEURS À RABAIS GRÂCE À VOTRE PASSE TOUT TEMPS</h4>

                                    <p>
                                        Grâce à votre « Skiez le Québec », obtenez deux journées
                                        à 50 % de rabais dans plusieurs centres de ski au Québec
                                        sur présentation de votre carte et de votre passe de saison
                                        Tout temps.
                                    </p>

                                    <p>
                                        Une valeur approximative de 950 $ en rabais!
                                    </p>

                                    <p>
                                        * Vallée du Parc n'est pas responsable de l'octroi des
                                        rabais offerts par les stations participantes.
                                    </p>

                                    <p>
                                        Vérifiez auprès de chacune des stations participantes avant
                                        votre visite, certaines conditions s'appliquent.
                                    </p>

                                    <ul>
                                        <li>Belle-Neige</li>
                                        <li>Le Chantecler</li>
                                        <li>Ski Garceau</li>
                                        <li>Mont Rigaud</li>
                                        <li>Val Saint-Côme</li>
                                        <li>Ski Saint-Bruno</li>
                                        <li>Ski Mont Habitant</li>
                                        <li>Mont Cascades</li>
                                        <li>Vallée Bleue</li>
                                        <li>Mont Kanasuta</li>
                                        <li>Mont Vidéo</li>
                                        <li>Val d'Irène</li>
                                        <li>Owl's Head</li>
                                        <li>Le Relais</li>
                                        <li>Mont Sutton</li>
                                    </ul>


                                    <!-- BRUNELLE -->

                                    <h4>BRUNELLE</h4>

                                    <p>
                                        Offre les mises au point de ski à 50 % de rabais
                                        entre le 1 octobre et le 1 novembre.
                                    </p>

                                    <p>
                                        Organise des soirées exclusives aux membres avec
                                        rabais de 20 à 50 % (dates à confirmer).
                                    </p>

                                    <p>
                                        Offre le service de mises au point durant la saison,
                                        avec service de dépôt à Vallée du Parc et un retour
                                        dans les 48 h suivantes.
                                    </p>

                                </div>


                            <!-- ==========================================
                                 SOIRÉE
                            =========================================== -->

                            <% } else if (category.includes("soiree")) { %>

                                <div class="subscription-info">

                                    <h3>
                                        Abonnement <em>Soirée</em>
                                    </h3>

                                    <p>
                                        L’abonnement
                                        <strong>Soirée</strong>
                                        est un abonnement de saison individuel.
                                    </p>

                                    <p>
                                        <strong>
                                            Valide 4 soirs dès le début de la saison :
                                        </strong>
                                    </p>

                                    <ul>
                                        <li>
                                            <strong>Mercredi au samedi :</strong>
                                            16h00 à 21h30
                                        </li>
                                    </ul>

                                    <p>
                                        L’abonnement
                                        <strong>Soirée</strong>
                                        sera valide de
                                        <strong>16h00 à 21h30</strong>
                                        durant la période de Noël et de la semaine de relâche.
                                    </p>

                                    <p>
                                        <strong>Périodes :</strong>
                                        du 23 décembre au 5 janvier 2026
                                        et du 28 février au 6 mars 2026.
                                    </p>

                                    <p class="subscription-bonus">
                                        <strong>EN PRIME :</strong>
                                        Lorsque le ski de soirée sera terminé,
                                        obtenez <strong>50 % de rabais</strong>
                                        à l’achat d’un billet journalier
                                        (bloc 1h, 2h, 3h, 4h ou journée)
                                        à prix régulier.
                                    </p>

                                </div>


                            <!-- ==========================================
                                 3J
                            =========================================== -->

                            <% } else if (
                                category.includes("3j") ||
                                category.includes("3 j") ||
                                category.includes("3-jours")
                            ) { %>

                                <div class="subscription-info">

                                    <h3>
                                        Abonnement <em>3J</em>
                                    </h3>

                                    <p>
                                        L’abonnement <strong>3J</strong>
                                        est un abonnement de saison individuel
                                        valide 3 jours par semaine.
                                    </p>

                                    <p>
                                        Valide de
                                        <strong>9h00 à 16h00</strong>,
                                        selon l’horaire choisi.
                                    </p>

                                    <p>
                                        <strong>
                                            4 options sont offertes aux clients :
                                        </strong>
                                    </p>

                                    <ol>
                                        <li>
                                            <strong>Taïga</strong>
                                            = Lundi – Mardi – Mercredi
                                        </li>

                                        <li>
                                            <strong>Boréal</strong>
                                            = Mardi – Mercredi – Jeudi
                                        </li>

                                        <li>
                                            <strong>Toundra</strong>
                                            = Mercredi – Jeudi – Vendredi
                                        </li>

                                        <li>
                                            <strong>Arctique</strong>
                                            = Lundi – Mercredi – Vendredi
                                        </li>
                                    </ol>

                                </div>


                            <!-- ==========================================
                                 FAMILIAL
                            =========================================== -->

                            <% } else if (category.includes("famil")) { %>

                                <div class="subscription-info">

                                    <h3>
                                        Abonnement <em>Familial</em>
                                    </h3>

                                    <p>
                                        Depuis la saison 2023-24,
                                        le concept de l’abonnement familial
                                        a été modifié.
                                    </p>

                                    <p>
                                        L’abonnement familial adopte un format
                                        <strong>« à la carte »</strong>
                                        et chacun des membres de votre famille
                                        doit être ajouté de façon individuelle.
                                    </p>

                                    <p>
                                        L’abonnement doit être constitué
                                        d’au moins
                                        <strong>1 parent (maximum 2)</strong>
                                        et d’un
                                        <strong>minimum de 3 personnes</strong>.
                                    </p>

                                    <p>
                                        Une preuve de résidence sera demandée
                                        pour chaque membre affilié à l’abonnement.
                                    </p>

                                    <p>
                                        L’abonnement sera également valide de
                                        <strong>9h00 à 21h30</strong>
                                        durant la période de Noël et de la semaine de relâche.
                                    </p>

                                    <p>
                                        <strong>Périodes :</strong>
                                        du 23 décembre au 5 janvier 2026
                                        et du 28 février au 6 mars 2026.
                                    </p>

                                    <p class="subscription-bonus">
                                        <strong>AVANTAGE :</strong>
                                        Avec cet abonnement illimité,
                                        obtenez gratuitement la carte
                                        <strong>Skiez et Surfez</strong>
                                        chez nos partenaires.
                                        <strong>Valeur approximative de 950 $.</strong>
                                    </p>

                                </div>

                            <% } %>


                            <!-- ==========================================
                                 PRIX
                            =========================================== -->

                            <div class="pricing-grid">

                                <% group.items.forEach(item => { %>

                                    <div class="price-row dual-price">

                                        <span class="price-label">
                                            <%= item.ageGroup %>
                                        </span>


                                        <div class="price-column">

                                            <small>Régulier</small>

                                            <strong>
                                                <%= item.regularPrice !== null
                                                    ? item.regularPrice + '$'
                                                    : '' %>
                                            </strong>

                                        </div>


                                        <div class="price-column">

                                            <small>Pré-vente</small>

                                            <strong>
                                                <%= item.fdcPrice !== null
                                                    ? item.fdcPrice + '$'
                                                    : '' %>
                                            </strong>

                                        </div>

                                    </div>

                                <% }) %>

                            </div>

                        </div>

                    </div>

                <% } %>

            <% }) %>

        <% } else { %>

            <p>Aucun prix disponible pour le moment.</p>

        <% } %>

    </div>

</section>


<!-- =========================================
     INFORMATIONS SUPPLÉMENTAIRES
========================================= -->

<section class="additional-info-section">

    <div class="additional-info-container">

        <h2>
            INFORMATIONS SUPPLÉMENTAIRES
        </h2>


        <div class="additional-info-tabs">

            <button
                class="additional-info-tab active"
                data-tab="code-conduite"
            >
                <span class="additional-info-icon">
                    ⛷
                </span>

                CODE DE CONDUITE
            </button>

        </div>


        <div
            class="additional-info-content active"
            id="code-conduite"
        >

            <h3>
                CODE DE CONDUITE
            </h3>

            <ul>

                <li>
                    L'abonné(e), le détenteur(trice) de billet journalier ou l'élève
                    s'engage à respecter intégralement le
                    <strong>code de conduite en montagne</strong>.
                    Ce code est adopté en vertu de la Loi sur la sécurité dans les sports.
                    Le présent code s'applique à toute personne qui pratique un sport de glisse.
                </li>

                <li>
                    Conservez la maîtrise de votre vitesse et de votre direction.
                    Assurez-vous d'être en mesure d'arrêter et éviter toute personne ou obstacle.
                </li>

                <li>
                    Cédez la priorité aux personnes en aval (plus bas) et empruntez
                    une direction qui assure leur sécurité.
                </li>

                <li>
                    Arrêtez dans une piste, seulement si vous êtes visibles des personnes
                    en amont (plus haut) et si vous n'obstruez pas la piste.
                </li>

                <li>
                    Cédez le passage aux personnes en amont (plus haut) lorsque vous
                    vous engagez dans une piste, de même qu'aux intersections.
                </li>

                <li>
                    Si vous êtes impliqué dans un accident ou en êtes témoin,
                    demeurez sur les lieux et identifiez-vous à un secouriste.
                </li>

                <li>
                    Utilisez et portez en tout temps un système approprié de rétention
                    de votre équipement.
                </li>

                <li>
                    N'utilisez pas les remontées mécaniques et les pistes si vous êtes
                    sous l'influence de drogues ou d'alcool.
                </li>

                <li>
                    Respectez toute signalisation et avertissement, et ne vous aventurez
                    jamais hors-piste ou sur les pistes fermées.
                    Une amende de 250 $ vous sera facturée si vous vous aventurez
                    hors du domaine skiable ou sur des pistes fermées.
                    Toute passe de saison émise demeure la propriété du Centre de Glisse,
                    et l'abonné s'engage à remettre cette passe sur demande de la direction.
                </li>

            </ul>

        </div>

    </div>

</section>


<script>

document.addEventListener("DOMContentLoaded", () => {

    const toggles = document.querySelectorAll(".pricing-toggle");

    toggles.forEach(toggle => {

        toggle.addEventListener("click", () => {

            const content = toggle.nextElementSibling;
            const icon = toggle.querySelector(".icon");

            content.classList.toggle("open");

            icon.textContent =
                content.classList.contains("open")
                    ? "−"
                    : "+";

        });

    });

});

</script>