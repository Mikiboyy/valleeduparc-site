<section class="pricing-section" id="billets">

    <h2>Billets journaliers</h2>

    <% if (adminUser && (adminUser.role === 'admin' || adminUser.role === 'prix')) { %>
        <a href="/admin-vdp/prices" class="btn-primary">
            Modifier les prix
        </a>
        <% } %>

    <% if (groupedTickets && groupedTickets.length > 0) { %>

        <% groupedTickets.forEach(categoryGroup => { %>

            <div class="pricing-category">

                <div class="category-title">
                    <%= categoryGroup.category %>
                </div>

                <div class="pricing-wrapper">

                    <% categoryGroup.tickets.forEach(ticket => { %>

                        <div class="pricing-group">

                            <button class="pricing-toggle">
                                <span><%= ticket.ticketType %></span>
                                <span class="icon">+</span>
                            </button>

                            <div class="pricing-content">

                                <div class="pricing-grid">

                                    <% ticket.items.forEach(item => { %>

                                        <div class="price-row dual-price">

                                            <span class="price-label">
                                                <%= item.ageGroup %>
                                            </span>

                                            <div class="price-column">
                                                <small>En ligne</small>

                                                <strong>
                                                    <% if (item.isFree) { %>
                                                        Gratuit
                                                        <% } else if (item.onlinePrice !== null) { %>
                                                            <%= item.onlinePrice %>$
                                                            <% } %>
                                                        </strong>
                                                    </div>

                                                    <div class="price-column">
                                                        <small>Billetterie</small>

                                                        <strong>
                                                            <% if (item.isFree) { %>
                                                                Gratuit
                                                                <% } else if (item.counterPrice !== null) { %>
                                                                    <%= item.counterPrice %>$
                                                                    <% } %>
                                                                </strong>
                                                            </div>

                                                            <% if (item.details && item.details.length > 0) { %>

                                                                <div class="ticket-details">

                                                                    <% item.details.forEach(detail => { %>

                                                                        <div class="ticket-detail">
                                                                            <span>•</span>
                                                                            <%= detail %>
                                                                        </div>

                                                                        <% }) %>

                                                                    </div>

                                                                    <% } %>
                                                                </div>

                                                                <% }) %>

                                                            </div>

                                                        </div>

                                                    </div>

                                                    <% }) %>

                                                </div>

                                            </div>
                                            
                                            <% }) %>

                                            <% } else { %>

                                                <p class="no-event">
                                                    Aucun prix disponible pour le moment.
                                                </p>

                                                <% } %>

                                            </section>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const toggles = document.querySelectorAll(".pricing-toggle");

    toggles.forEach(toggle => {
        toggle.addEventListener("click", () => {
            const content = toggle.nextElementSibling;
            const icon = toggle.querySelector(".icon");

            content.classList.toggle("open");
            icon.textContent = content.classList.contains("open") ? "−" : "+";
        });
    });
});
</script>